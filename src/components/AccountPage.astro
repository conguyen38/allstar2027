---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramHeader from './ProgramHeader.astro';
import Footer from './Footer.astro';

interface Props {
  program: 'prm' | 'sih';
}

const { program } = Astro.props;
const programName = program === 'prm' ? 'PRM Techcombank' : 'LLB OneHousing';
const rulesHref = `/${program}/the-le/`;
const label = "text-xs font-bold uppercase tracking-normal text-white/65 font-body";
---

<BaseLayout
  title={`Tài khoản của tôi - ${programName} - Allstar Club`}
  description="Xem điểm, thứ hạng, U-Point chi trả và các mốc thưởng của bạn trong chương trình Allstar Club."
  canonicalPath={`/${program}/tai-khoan/`}
  bodyClass="page-bg allstar-grid-bg text-on-surface antialiased font-body"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      body { background: #120b15; }
      .page-bg {
        background:
          radial-gradient(ellipse 80% 50% at 20% 20%, rgba(121, 59, 121, 0.18) 0%, transparent 60%),
          radial-gradient(ellipse 60% 40% at 80% 10%, rgba(255, 141, 180, 0.1) 0%, transparent 50%),
          radial-gradient(ellipse 50% 60% at 50% 80%, rgba(121, 59, 121, 0.12) 0%, transparent 60%),
          #120b15;
        min-height: 100vh;
      }
      .trails-svg { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; opacity: 0.45; }
      @keyframes trail-move {
        0% { stroke-dashoffset: 1000; opacity: 0; }
        20% { opacity: 1; }
        80% { opacity: 0.6; }
        100% { stroke-dashoffset: 0; opacity: 0; }
      }
      .trail-line { stroke-dasharray: 400 600; animation: trail-move 6s linear infinite; }
      .trail-line:nth-child(2) { animation-delay: 1.5s; animation-duration: 7s; }
      .trail-line:nth-child(3) { animation-delay: 3s; animation-duration: 5.5s; }
      .trail-line:nth-child(4) { animation-delay: 0.8s; animation-duration: 8s; }
      .trail-line:nth-child(5) { animation-delay: 2.2s; animation-duration: 6.5s; }
      .glass { background: rgba(255, 255, 255, 0.04); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.09); }
      .glass-gold { background: rgba(255, 196, 153, 0.06); backdrop-filter: blur(20px); border: 1px solid rgba(255, 196, 153, 0.25); }
      .glass-cyan { background: rgba(255, 141, 180, 0.05); backdrop-filter: blur(16px); border: 1px solid rgba(255, 141, 180, 0.22); }
      .hero-glow { box-shadow: 0 0 60px rgba(255, 196, 153, 0.12), inset 0 0 40px rgba(255, 196, 153, 0.04); }
      .badge-gold {
        background: linear-gradient(135deg, #ffe3c4, #ffb784, #e8846b);
        box-shadow: 0 0 20px rgba(255, 183, 132, 0.55), 0 4px 12px rgba(0, 0, 0, 0.4);
        color: #45152f;
      }
      .gold-text { background: linear-gradient(135deg, #ffe8d4, #ffc499 50%, #ff8d78); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .progress-fill { background: linear-gradient(90deg, #ff8db4, #ffc499); transition: width 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
      .period-picker { position: relative; width: max-content; }
      .period-trigger {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.6rem;
        padding: 0.5rem 0.7rem;
        border: 1px solid rgba(255, 141, 180, 0.72);
        border-radius: 0;
        background: rgba(45, 26, 53, 0.94);
        color: #fff;
        box-shadow: none;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }
      .period-trigger:hover, .period-trigger[aria-expanded="true"] { border-color: #ff8db4; background: #4c264c; }
      .period-trigger:focus-visible { outline: 2px solid #ffc499; outline-offset: 3px; }
      .period-menu {
        position: absolute;
        z-index: 20;
        top: calc(100% + 0.4rem);
        right: 0;
        display: grid;
        min-width: 100%;
        overflow: hidden;
        border: 1px solid rgba(255, 141, 180, 0.72);
        border-radius: 0;
        background: #2f1b38;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.28);
      }
      .period-menu.hidden { display: none; }
      .period-menu-item {
        min-width: max-content;
        padding: 0.65rem 0.85rem;
        border: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: transparent;
        color: rgba(255, 255, 255, 0.82);
        font: inherit;
        font-size: 0.875rem;
        font-weight: 700;
        text-align: left;
        white-space: nowrap;
      }
      .period-menu-item:last-child { border-bottom: 0; }
      .period-menu-item:hover, .period-menu-item:focus-visible { background: rgba(255, 141, 180, 0.12); color: #fff; outline: none; }
      .period-menu-item[aria-selected="true"] { background: rgba(255, 141, 180, 0.18); color: #fff; }
      .tracuu-btn { background: linear-gradient(135deg, #ff7f6b, #ffc499); color: #45152f; font-weight: 800; transition: all 0.25s; }
       .tracuu-btn:hover { box-shadow: 0 0 20px rgba(255, 140, 110, 0.5), 0 0 40px rgba(255, 120, 100, 0.25); transform: translateY(-1px); }

       /* Account cards use clean right angles for faster scanning. */
       .account-tactical .glass,
       .account-tactical .glass-gold,
       .account-tactical .glass-cyan,
       .account-tactical [data-cards] > div {
         --account-cyan: rgba(255, 141, 180, 0.52);
         --account-gold: rgba(255, 196, 153, 0.72);
         position: relative;
         isolation: isolate;
         overflow: hidden;
         border: 1px solid var(--account-cyan) !important;
         border-radius: 0 !important;
         clip-path: none;
         background: linear-gradient(112deg, rgba(70, 37, 70, 0.92), rgba(40, 25, 53, 0.94)) !important;
         box-shadow: inset 0 1px 0 rgba(255, 220, 205, 0.14), 0 16px 30px rgba(24, 14, 28, 0.26) !important;
       }
      .account-tactical .glass-gold { border-color: var(--account-gold) !important; background: linear-gradient(112deg, rgba(112, 56, 66, 0.9), rgba(44, 24, 54, 0.95)) !important; }
       .account-tactical .glass::before,
       .account-tactical .glass-gold::before,
       .account-tactical .glass-cyan::before,
       .account-tactical [data-cards] > div::before {
         content: none;
         position: absolute;
         inset: 0;
         z-index: 0;
         pointer-events: none;
         background:
           linear-gradient(90deg, var(--account-cyan), transparent 18%) top left / 100% 1px no-repeat,
           linear-gradient(270deg, var(--account-gold), transparent 16%) bottom right / 100% 1px no-repeat;
       }
       .account-tactical .glass > *,
       .account-tactical .glass-gold > *,
       .account-tactical .glass-cyan > *,
       .account-tactical [data-cards] > div > * { position: relative; z-index: 1; }

      /* Thẻ điểm bấm để mở chi tiết */
      .card-expandable { cursor: pointer; padding-bottom: 2rem; }
      .card-expandable:hover { border-color: rgba(255, 141, 180, 0.85) !important; }
      .card-expandable:focus-visible { outline: 2px solid #ffc499; outline-offset: 2px; }
      /* selector dài để thắng rule ".account-tactical [data-cards] > div > * { position: relative }" của thẻ */
      .account-tactical [data-cards] > div > .card-chev { position: absolute; right: 0.6rem; bottom: 0.4rem; transition: transform 0.25s; }
      .card-expandable[aria-expanded="true"] .card-chev { transform: rotate(180deg); }

      /* Danh sách căn ghi nhận */
      .units-th { padding: 0.75rem 1rem; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); border-bottom: 1px solid rgba(255, 141, 180, 0.3); white-space: nowrap; }
      .units-th.text-right { text-align: right; }
      .units-td { padding: 0.7rem 1rem; color: rgba(255, 255, 255, 0.78); white-space: nowrap; }
      .units-row { border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
      .units-row:last-child { border-bottom: 0; }
      .units-row:hover { background: rgba(255, 141, 180, 0.05); }
      .unit-paid { color: #4ade80; }
      .unit-unpaid { color: #f87171; }

      /* Thanh tiến độ chia theo mốc: mỗi đoạn là một mốc, đoạn nào qua rồi thì đầy */
      .prog-row { display: flex; gap: 4px; }
      .prog-seg { position: relative; flex: 1 1 0; height: 10px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
      .prog-seg-fill { height: 100%; width: 0; background: linear-gradient(90deg, #ff8db4, #ffc499); transition: width 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
      .prog-seg-done .prog-seg-fill { background: linear-gradient(90deg, #ffc499, #ff9d7a); }
      .prog-seg-now { outline: 1px solid rgba(255, 141, 180, 0.8); outline-offset: 1px; }
      .prog-label { flex: 1 1 0; min-width: 0; text-align: right; line-height: 1.25; color: rgba(255, 255, 255, 0.42); }
      .prog-label-n { display: block; font-family: 'Roboto', Arial, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: normal; text-transform: uppercase; }
      .prog-label-v { display: block; font-size: 13px; font-weight: 700; }
      .prog-label-on { color: #ffc499; }
      @media (max-width: 640px) { .prog-label-n { display: none; } .prog-label-v { font-size: 11px; } }

      /* Dòng trạng thái cập nhật dữ liệu, đặt ngay dưới tên để người dùng thấy ngay số liệu mới tới đâu */
      .update-chip { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.75rem; font-size: 0.8125rem; color: rgba(255, 255, 255, 0.7); border: 1px solid rgba(255, 141, 180, 0.4); background: rgba(255, 141, 180, 0.07); }
      .update-chip b { font-weight: 700; color: #fff; }

      /* Chọn năm */
      .year-tab { padding: 0.35rem 0.8rem; font: inherit; font-size: 0.8rem; font-weight: 700; color: rgba(255, 255, 255, 0.6); border: 1px solid rgba(255, 255, 255, 0.18); background: transparent; cursor: pointer; transition: color 0.2s, border-color 0.2s, background 0.2s; }
      .year-tab:hover { color: #fff; border-color: rgba(255, 141, 180, 0.6); }
      .year-tab[aria-pressed="true"] { color: #fff; border-color: #ff8db4; background: rgba(255, 141, 180, 0.16); }
      .year-tab:focus-visible { outline: 2px solid #ffc499; outline-offset: 2px; }

      /* Hành trình du lịch */
      .journey-win { border-color: rgba(255, 196, 153, 0.7) !important; }
      .journey-win .journey-msg { color: #ffc499; }
      .journey-miss .journey-msg { color: #fda4af; }
      .journey-card:not(.journey-win):not(.journey-miss) .journey-msg { color: #ff8db4; }
      .journey-road { position: relative; margin: 3.5rem 0.9rem 0.25rem; height: 14px; }
      .journey-track { position: absolute; inset: 3px 0; border-radius: 9999px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
      .journey-fill { height: 100%; border-radius: 9999px; background: linear-gradient(90deg, #ff8db4, #ffc499); transition: width 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
      .journey-stop { position: absolute; top: 50%; z-index: 2; width: 30px; height: 30px; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; border-radius: 9999px; background: #1a0f1e; border: 2px solid rgba(255, 255, 255, 0.22); color: rgba(255, 255, 255, 0.4); }
      .journey-stop-on { border-color: #ffc499; color: #45152f; background: linear-gradient(135deg, #ffe3c4, #ffb784, #e8846b); box-shadow: 0 0 16px rgba(255, 183, 132, 0.45); }
      .journey-plane { display: block; transform: rotate(90deg); } /* icon máy bay mặc định hướng lên → quay sang phải theo chiều đi */
      .journey-rider { position: absolute; top: -46px; z-index: 3; transform: translateX(-50%); color: #ff8db4; transition: left 1.1s cubic-bezier(0.16, 1, 0.3, 1); filter: drop-shadow(0 0 8px rgba(255, 141, 180, 0.7)); }

      /* Các mốc bonus theo kỳ */
      .bp-chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.6rem; font-size: 12px; font-weight: 700; border: 1px solid; }
      .bp-chip-on { color: #ffc499; border-color: rgba(255, 196, 153, 0.7); background: rgba(255, 196, 153, 0.1); }
      .bp-chip-off { color: rgba(255, 255, 255, 0.4); border-color: rgba(255, 255, 255, 0.14); }

      /* Pop-up cảnh báo duy trì thành viên */
      .warn-panel { border: 1px solid rgba(255, 196, 153, 0.8); background: linear-gradient(112deg, rgba(84, 40, 56, 0.97), rgba(43, 25, 51, 0.98)); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55); }
      .warn-item { border-left: 3px solid #f87171; padding-left: 0.75rem; }

      /* Timeline các mốc thưởng */
      .tl-node { border: 2px solid rgba(255, 255, 255, 0.15); background: #1a0f1e; color: rgba(255, 255, 255, 0.35); }
      .tl-node-done { border-color: #ffc499; background: linear-gradient(135deg, #ffe3c4, #ffb784, #e8846b); color: #45152f; box-shadow: 0 0 18px rgba(255, 183, 132, 0.45); }
      .tl-node-next { border-color: #ff8db4; color: #ff8db4; box-shadow: 0 0 18px rgba(255, 141, 180, 0.4); animation: tl-pulse 2s ease-in-out infinite; }
      @keyframes tl-pulse { 50% { box-shadow: 0 0 6px rgba(255, 141, 180, 0.2); } }
      .tl-list { display: flex; flex-direction: column; }
      .tl-item { display: flex; flex-direction: row; gap: 1rem; }
      .tl-rail { display: flex; flex-direction: column; align-items: center; }
      .tl-line { position: relative; flex: 1 1 auto; min-height: 2rem; width: 2px; margin: 0.5rem 0; border-radius: 9999px; background: rgba(255, 255, 255, 0.12); }
      .tl-fill { position: absolute; left: 0; top: 0; width: 100%; height: var(--fill, 0%); border-radius: 9999px; background: linear-gradient(180deg, #ffc499, #ff8db4); transition: height 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
      .tl-body { min-width: 0; padding-bottom: 1.5rem; }
      .tl-item:last-child .tl-body { padding-bottom: 0; }
      @media (min-width: 768px) {
        .tl-scroll { overflow-x: auto; }
        .tl-list { flex-direction: row; }
        .tl-item { flex: 1 0 9.5rem; flex-direction: column; gap: 1rem; }
        .tl-rail { flex-direction: row; width: 100%; }
        .tl-line { min-height: 0; width: auto; height: 2px; margin: 0 0.75rem; }
        .tl-fill { width: var(--fill, 0%); height: 100%; background: linear-gradient(90deg, #ffc499, #ff8db4); transition-property: width; }
        .tl-body { padding: 0 1rem 0 0; }
        .tl-scroll.has-more { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent); }
      }
    </style>
  </Fragment>

  <!-- Neon light trails -->
  <svg class="trails-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <line class="trail-line" x1="-100" y1="200" x2="1540" y2="180" stroke="rgba(255, 141, 180,0.4)" stroke-width="1" />
    <line class="trail-line" x1="-100" y1="450" x2="1540" y2="420" stroke="rgba(255, 196, 153,0.35)" stroke-width="0.8" />
    <line class="trail-line" x1="-100" y1="680" x2="1540" y2="700" stroke="rgba(255, 141, 180,0.3)" stroke-width="1.2" />
    <line class="trail-line" x1="200" y1="-50" x2="180" y2="950" stroke="rgba(255, 141, 180,0.25)" stroke-width="0.8" />
    <line class="trail-line" x1="1100" y1="-50" x2="1120" y2="950" stroke="rgba(255, 196, 153,0.2)" stroke-width="1" />
  </svg>

  <ProgramHeader program={program} active="account" />

  <main class="relative z-10 pt-20 pb-20 min-h-[75vh] account-tactical" data-account-root data-account-program={program}>
    <div class="max-w-6xl mx-auto px-4 md:px-8 pt-10">
      <p data-account-loading class="text-white/40 text-sm flex items-center gap-2">
        <span class="material-symbols-outlined text-xl">hourglass_top</span> Đang tải…
      </p>

      <!-- Chưa đăng nhập -->
      <section data-account-guest class="hidden max-w-md mx-auto text-center glass rounded-2xl p-8 mt-10 space-y-4">
        <span class="material-symbols-outlined text-5xl text-primary">lock</span>
        <h1 class="font-black text-2xl text-white">Vui lòng đăng nhập</h1>
        <p class="text-white/50 text-sm">Đăng nhập để xem điểm và U-Point của bạn.</p>
        <button type="button" data-auth-open class="tracuu-btn rounded-xl px-6 py-3 text-sm">Đăng nhập</button>
      </section>

      <!-- Đã đăng nhập -->
      <div data-account-view class="hidden space-y-6">
        <!-- Page header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="font-arena uppercase text-4xl md:text-6xl leading-[0.95] text-white tracking-wide">
              Xin chào, <span class="text-primary" data-field="name"></span>
            </h1>
            <p class="text-white/40 text-sm mt-1" data-field="profileLine"></p>
            <p class="update-chip mt-3">
              <span class="material-symbols-outlined text-[16px] text-secondary">update</span>
              <span>Cập nhật lần cuối: <b data-field="updatedAt"></b></span>
            </p>
          </div>
          <div class="flex flex-col items-end self-start sm:self-auto">
            <div class="flex gap-1.5 mb-3 hidden" data-year-tabs role="group" aria-label="Chọn năm"></div>
            <label for="period-select" class={label + ' block mb-1.5 text-right'}>Kỳ tính</label>
            <div class="period-picker">
              <button id="period-select" type="button" class="period-trigger" data-period-trigger aria-haspopup="listbox" aria-expanded="false">
                <span class="material-symbols-outlined text-secondary text-[20px]">event</span>
                <span data-period-label></span>
                <span class="material-symbols-outlined text-white/70 text-[20px]">expand_more</span>
              </button>
              <div class="period-menu hidden" data-period-menu role="listbox" aria-labelledby="period-select"></div>
              <select class="hidden" data-period-select aria-hidden="true" tabindex="-1"></select>
            </div>
            <p class="text-[11px] font-bold uppercase tracking-wider mt-1.5 text-right text-white/40" data-period-status data-field="periodStatus"></p>
          </div>
        </div>

        <!-- Hero: tổng điểm + thứ hạng -->
        <section class="glass-gold hero-glow rounded-2xl p-5 sm:p-6 md:p-8">
          <div class="flex flex-row items-center justify-between gap-4 md:gap-6">
            <div class="min-w-0">
              <p class={label} data-field="heroLabel"></p>
              <p class="gold-text font-wide italic font-black text-5xl sm:text-6xl md:text-7xl leading-none mt-2 tracking-tight" data-field="totalPoints"></p>
            </div>
            <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 rounded-2xl glass px-4 py-3 sm:px-6 sm:py-4 shrink-0 text-center sm:text-left">
              <div class="badge-gold w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined">emoji_events</span>
              </div>
              <div>
                <p class={label} data-field="rankLabel">Thứ hạng</p>
                <p class="font-wide italic font-black text-2xl sm:text-3xl text-white leading-none mt-1" data-field="rank"></p>
              </div>
            </div>
          </div>
          <div class="mt-6">
            <div data-progress-segments></div>
            <p class="text-sm text-white/55 mt-3" data-field="nextTier"></p>
          </div>
        </section>

        <!-- Hành trình du lịch theo nửa năm (chỉ PRM) -->
        <section data-journey-section class="hidden">
          <h2 class="font-arena uppercase tracking-wide text-2xl md:text-3xl text-white mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">travel_explore</span> Hành trình du lịch
          </h2>
          <div class="grid gap-3 sm:gap-4 md:grid-cols-2" data-journey></div>
        </section>

        <!-- Chi tiết điểm (khác nhau theo chương trình) -->
        <section class="grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-5 items-stretch" data-cards></section>
        <template data-card-template>
          <div class="rounded-2xl p-4 sm:p-5">
            <div class="flex items-start justify-between gap-2">
              <p class="font-body text-xs font-bold uppercase tracking-normal text-white/65 leading-snug" data-card="label"></p>
              <span class="material-symbols-outlined text-white/35 text-[20px]" data-card="icon"></span>
            </div>
            <p class="font-wide italic font-black text-xl sm:text-2xl mt-3 leading-tight" data-card="value"></p>
            <p class="text-xs text-white/45 mt-2 leading-relaxed" data-card="sub"></p>
            <div class="hidden mt-3 pt-2 border-t border-white/10" data-card="detail"></div>
            <span class="material-symbols-outlined card-chev text-white/40 text-[18px]" data-card="chev">expand_more</span>
          </div>
        </template>

        <!-- U-Point chi trả -->
        <section class="glass rounded-2xl p-5 md:p-6 grid gap-5 lg:gap-8 lg:grid-cols-2 lg:items-center">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 shrink-0 rounded-xl bg-primary/10 border border-primary/25 flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">payments</span>
            </div>
            <div class="min-w-0">
              <p class={label} data-field="payoutTitle"></p>
              <p class="font-wide italic font-black text-2xl sm:text-3xl text-white mt-1.5">
                <span class="gold-text" data-field="uPointPayout"></span>
                <span class="text-base text-white/50 font-bold whitespace-nowrap">U-Point</span>
              </p>
            </div>
          </div>
          <div>
            <ul class="divide-y divide-white/10" data-payout-lines></ul>
            <p class="text-xs text-white/40 leading-relaxed mt-2">
              <span data-field="payoutNote"></span>
              <a href={rulesHref} class="text-secondary hover:underline whitespace-nowrap">Xem thể lệ</a>
            </p>
          </div>
        </section>

        <!-- Danh sách căn ghi nhận (SM: căn của cả team) -->
        <section data-units-section>
          <h2 class="font-arena uppercase tracking-wide text-2xl md:text-3xl text-white mb-1 flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">domain</span> <span data-field="unitsTitle"></span>
          </h2>
          <p class="text-xs text-white/45 mb-3">
            <span data-field="unitsSub"></span>
            <span class="unit-paid font-bold">Chữ xanh: đã chi trả</span> ·
            <span class="unit-unpaid font-bold">Chữ đỏ: chưa chi trả &amp; đối soát</span>
          </p>
          <div class="glass rounded-2xl overflow-x-auto" tabindex="0" role="region" aria-label="Bảng thông tin, kéo ngang để xem đầy đủ">
            <table class="w-full text-sm min-w-[640px]">
              <thead data-units-head></thead>
              <tbody data-units-body></tbody>
            </table>
            <p class="hidden text-sm text-white/45 px-5 py-6" data-units-empty>Chưa có căn nào được ghi nhận.</p>
          </div>
        </section>

        <!-- Các mốc bonus theo kỳ (ẩn nếu vai trò không áp dụng) -->
        <section data-tiers-section>
          <h2 class="font-arena uppercase tracking-wide text-2xl md:text-3xl text-white mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">stairs</span> <span data-field="tiersTitle"></span>
          </h2>
          <div class="grid gap-3 sm:gap-4 md:grid-cols-2" data-bonus-periods></div>
        </section>

        <!-- Cảnh báo duy trì thành viên -->
        <div data-warn-modal class="hidden fixed inset-0 z-[80] flex items-center justify-center p-4" role="alertdialog" aria-modal="true" aria-labelledby="warn-title">
          <div class="absolute inset-0 bg-black/50" data-warn-close></div>
          <div class="warn-panel relative w-full max-w-md p-6 md:p-7">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[32px] text-primary">warning</span>
              <h2 id="warn-title" class="font-arena uppercase tracking-wide text-2xl text-white leading-none">Cảnh báo duy trì thành viên</h2>
            </div>
            <ul class="mt-4 space-y-3" data-warn-list></ul>
            <p class="text-sm text-white/65 mt-4">
              Vui lòng kiểm tra điều kiện duy trì trong <a href={rulesHref} class="text-secondary hover:underline">Thể lệ</a>
              và phát sinh thêm điểm / HBK để giữ quyền lợi thành viên. Cần hỗ trợ, hãy liên hệ quản lý trực tiếp của bạn.
            </p>
            <button type="button" data-warn-close class="tracuu-btn rounded-xl px-6 py-3 text-sm mt-5 w-full">Đã hiểu</button>
          </div>
        </div>

        <p class="text-xs text-white/30">
          Dữ liệu trên trang này đang là dữ liệu mẫu.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
