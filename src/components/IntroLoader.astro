<dialog class="sunset-opening" aria-label="Mở đầu Allstar Club">
  <div class="opening-mark">
    <img src="/assets/images/allstar-27.webp" width="1024" height="872" alt="Allstar Club" />
    <span class="opening-light" aria-hidden="true"></span>
  </div>
</dialog>
<script is:inline>
  (() => {
    const dialog = document.currentScript.previousElementSibling;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !dialog.showModal) return;
    try {
      if (sessionStorage.getItem('allstar-sunset-intro')) return;
      sessionStorage.setItem('allstar-sunset-intro', '1');
    } catch {}
    dialog.showModal();
    let closing = false;
    let closeTimer;
    const finish = () => {
      if (closing) return;
      closing = true;
      dialog.classList.add('is-closing');
      closeTimer = setTimeout(() => dialog.close(), 500);
    };
    const startTime = performance.now();
    const hero = document.querySelector('.club-scene');
    const assets = Promise.all([
      dialog.querySelector('img').decode().catch(() => {}),
      hero ? hero.decode().catch(() => {}) : Promise.resolve(),
    ]);
    Promise.race([assets, new Promise(resolve => setTimeout(resolve, 4500))])
      .then(() => setTimeout(finish, Math.max(0, 2900 - (performance.now() - startTime))));
    dialog.addEventListener('cancel', event => {
      event.preventDefault();
      finish();
    });
    dialog.addEventListener('close', () => clearTimeout(closeTimer), { once: true });
  })();
</script>
