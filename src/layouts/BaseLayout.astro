---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  bodyClass?: string;
  htmlClass?: string;
  scrollEffects?: boolean;
  scrollRevealMode?: 'mixed' | 'section-only';
}

const {
  title,
  description = 'Allstar Club là chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing.',
  canonicalPath = '/',
  ogImage = 'https://onehousing.club/assets/images/thumbnail.jpg',
  bodyClass = 'bg-[#06090f] text-on-surface font-body antialiased',
  htmlClass = 'dark',
  scrollEffects = false,
  scrollRevealMode = 'mixed',
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://onehousing.club').toString();
const programAssetBase = canonicalPath.startsWith('/prm/')
  ? '/prm'
  : canonicalPath.startsWith('/sih/')
    ? '/sih'
    : '';
const shouldPreloadHero = scrollEffects && Boolean(programAssetBase);
const heroImage = shouldPreloadHero ? `${programAssetBase}/assets/images/Herobanner1.webp` : '';
---

<!DOCTYPE html>
<html class={htmlClass} lang="vi">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4FSESX9SG5');

      (() => {
        const isLocal = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname);
        if (isLocal) return;
        const loadAnalytics = () => {
          if (document.querySelector('script[data-gtag]')) return;
          const script = document.createElement('script');
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-4FSESX9SG5';
          script.async = true;
          script.dataset.gtag = 'true';
          document.head.appendChild(script);
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadAnalytics, { timeout: 3000 });
        } else {
          window.addEventListener('load', () => window.setTimeout(loadAnalytics, 1500), { once: true });
        }
      })();
    </script>
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {shouldPreloadHero && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
      <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    </noscript>
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-scroll-effects={scrollEffects ? 'true' : undefined}
    data-scroll-reveal-mode={scrollEffects ? scrollRevealMode : undefined}
  >
    <slot />
    {scrollEffects && (
      <script is:inline>
        (() => {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const revealMode = document.body.dataset.scrollRevealMode || 'mixed';
          const main = document.querySelector('main') || document.body;
          const sections = Array.from(main.querySelectorAll(':scope > section'));
          const rootCards = Array.from(document.querySelectorAll('.cards > .card'));
          const ruleSections = Array.from(main.querySelectorAll(':scope > section > [id^="sec-"]'));
          const revealSections = revealMode === 'section-only'
            ? (ruleSections.length ? ruleSections : sections.slice(1))
            : sections.slice(1);
          const gridItems = revealMode === 'section-only'
            ? []
            : Array.from(main.querySelectorAll('section .grid > *, section .space-y-12 > .glass-card'));
          const targets = [...revealSections, ...rootCards, ...gridItems].filter((item, index, list) => list.indexOf(item) === index);

          targets.forEach((item, index) => {
            item.classList.add('scroll-reveal');
            if (!revealSections.includes(item)) item.classList.add('scroll-reveal-soft');
            item.style.setProperty('--reveal-delay', `${Math.min((index % 6) * 70, 350)}ms`);
          });

          if (revealMode === 'section-only') {
            revealSections[0]?.classList.add('is-visible');
          }

          if (reduceMotion || !('IntersectionObserver' in window)) {
            targets.forEach((item) => item.classList.add('is-visible'));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
          );

          targets.forEach((item) => {
            if (item.classList.contains('is-visible')) return;
            observer.observe(item);
          });
        })();
      </script>
    )}
  </body>
</html>
