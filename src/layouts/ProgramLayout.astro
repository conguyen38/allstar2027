---
import BaseLayout from './BaseLayout.astro';
import ProgramHeader from '../components/ProgramHeader.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  program: 'prm' | 'sih';
  active: 'index' | 'tong-quan' | 'the-le' | 'bxh' | 'refer';
  bodyClass?: string;
  scrollEffects?: boolean;
  scrollRevealMode?: 'mixed' | 'section-only';
}

const {
  title,
  description,
  canonicalPath,
  program,
  active,
  bodyClass = 'page-bg text-on-surface font-body selection:bg-primary/30 selection:text-primary overflow-x-hidden',
  scrollEffects = active === 'index' || active === 'tong-quan' || active === 'the-le',
  scrollRevealMode = active === 'the-le' ? 'section-only' : 'mixed',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  bodyClass={bodyClass}
  scrollEffects={scrollEffects}
  scrollRevealMode={scrollRevealMode}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <slot name="beforeHeader" />
  <ProgramHeader program={program} active={active} />
  <slot />
  <Footer />
  <script src="/assets/shared.js" defer></script>
</BaseLayout>
