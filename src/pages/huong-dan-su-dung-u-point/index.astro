---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramHeader from '../../components/ProgramHeader.astro';
import Footer from '../../components/Footer.astro';

const title = 'Hướng dẫn sử dụng U-Point | Allstar Club';
const description = 'Hướng dẫn sử dụng U-Point và đặc quyền thành viên Allstar trên ứng dụng Techcombank OneU.';

const features = [
  { icon: 'feature-voucher.png', title: 'Đổi voucher', copy: 'Sử dụng U-Point để đổi voucher giảm giá từ hàng trăm thương hiệu.' },
  { icon: 'feature-food.png', title: 'Đặt món', copy: 'Sử dụng U-Point để đặt đồ ăn tại hàng loạt thương hiệu.' },
  { icon: 'feature-ticket.png', title: 'Mua vé', copy: 'Dùng điểm để mua vé các sự kiện thể thao, ca nhạc, giải trí.' },
  { icon: 'feature-airline.png', title: 'Đổi dặm Vietnam Airlines', copy: 'Sử dụng U-Point để đổi dặm bay Vietnam Airlines và ngược lại.' },
  { icon: 'feature-car.png', title: 'Đặt xe', copy: 'Thanh toán các chuyến đi Xanh SM trực tiếp bằng U-Point.' },
  { icon: 'feature-game.png', title: 'Gamification', copy: 'Tham gia các trò chơi trên app OneU để có cơ hội nhận thưởng U-Point giá trị.' },
  { icon: 'feature-qr.png', title: 'Thanh toán trực tiếp', copy: 'Dùng điểm để thanh toán tại cửa hàng của đối tác qua mã QR (hiện áp dụng tại hệ thống Golden Gate).' },
  { icon: 'feature-winmart.png', title: 'Đổi Voucher WinMart - Giảm 4%', copy: 'Sử dụng U-Point để đổi voucher mua sắm tại WinMart, WinMart+.' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/huong-dan-su-dung-u-point/" bodyClass="u-point-page" scrollEffects={false}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </Fragment>
  <ProgramHeader program="prm" active="u-point" />

  <main class="u-point-main">
    <div class="desktop-shell artboard-shell">
      <article class="desktop-artboard artboard" aria-label="Hướng dẫn sử dụng U-Point">
        <section class="hero">
          <img class="hero-bg" src="/u-point/layers/hero-background.png" alt="" />
          <img class="heading-image hero-title" src="/u-point/layers/figma-desktop-hero-title.png" alt="Hướng dẫn sử dụng U-Point và đặc quyền thành viên Allstar" />
          <div class="hero-subtitle">TRÊN ỨNG DỤNG TECHCOMBANK ONEU</div>
        </section>

        <div class="section-divider"></div>

        <section class="oneu-section">
          <img class="heading-image oneu-heading" src="/u-point/layers/figma-oneu-heading.png" alt="Giao diện App Techcombank OneU và thông tin điểm" />
          <img class="main-phone" src="/u-point/layers/transparent/desktop-phone.png?v=4" alt="Giao diện ứng dụng Techcombank OneU" />

          <div class="info-pill voucher-pill">Kho voucher và Số dư U-point</div>
          <img class="voucher-screen" src="/u-point/layers/voucher-screen-hq.png?v=5" alt="Kho voucher trên OneU" />
          <p class="voucher-copy">Kho lưu trữ các loại voucher KH đã đổi điểm/ thu thập miễn phí hoặc voucher được tặng</p>

          <img class="points-screen" src="/u-point/layers/points-screen-hq.png?v=5" alt="Thông tin số dư U-Point" />
          <ul class="points-copy">
            <li>Thể hiện số U-point ở cả 2 nguồn TCB &amp; OneU</li>
            <li>Khi truy cập dẫn đến màn <strong>Số dư điểm, Quản lý Điểm &amp; Lịch sử giao dịch điểm</strong></li>
          </ul>

          <div class="connector connector-left"></div>
          <div class="connector connector-right"></div>
          <div class="route-block route-left">
            <h3>Đường dẫn truy cập các tính năng &amp; collection</h3>
            <ul>
              <li>Tính năng đặt món</li>
              <li>Collections “Voucher siêu thị”, “Voucher HOT”,...</li>
              <li>Tất cả tiện ích</li>
            </ul>
          </div>
          <div class="route-block route-right"><h3>Các chương trình ưu đãi theo từng thời kì</h3></div>
        </section>

        <section class="pnp-section">
          <img class="heading-image pnp-title" src="/u-point/layers/extracted/pnp-title-hq.png" alt="Giao diện PNP đặc quyền" />
          <div class="pnp-subtitle">DÀNH RIÊNG CHO THÀNH VIÊN ALLSTAR</div>
          <img class="pnp-phones-figma" src="/u-point/layers/figma-pnp-phones.png?v=1" alt="Giao diện Techcombank Private và Priority dành cho hội viên Allstar" />
          <p class="pnp-copy pnp-copy-left">Chọn <strong>“Đặc quyền hội viên Techcombank Private &amp; Priority”</strong> để khám phá những voucher, ưu đãi dành riêng cho thành viên Allstar Club.</p>
          <p class="pnp-copy pnp-copy-right">Giao diện dành cho VIP, khám phá vô vàn ưu đãi từ các hạng mục: Hàng hiệu, Mua sắm, Ẩm thực,...</p>
          <span class="pnp-line line-left"></span>
          <span class="pnp-line line-right"></span>
          <a class="pnp-cta" href="https://s.oneu.vn/dlp_pnp" target="_blank" rel="noopener noreferrer">Trải nghiệm ngay</a>
        </section>

        <section class="features-section">
          <div class="features-heading" role="img" aria-label="Các tính năng trên app Techcombank OneU">
            <img class="features-heading-line features-heading-line-one" src="/u-point/layers/figma-features-heading.png" alt="" />
            <img class="features-heading-line features-heading-line-two" src="/u-point/layers/figma-features-heading.png" alt="" />
          </div>
          <div class="feature-grid">
            {features.map((feature) => (
              <article class="feature-item">
                <img src={`/u-point/layers/transparent/${feature.icon}?v=4`} alt="" />
                <div><h3>{feature.title}</h3><p>{feature.copy}</p></div>
              </article>
            ))}
          </div>
        </section>

        <section class="programs-section">
          <div class="programs-heading" role="img" aria-label="Các chương trình trên app Techcombank OneU">
            <img class="programs-heading-line programs-heading-line-one" src="/u-point/layers/figma-programs-heading.png" alt="" />
            <img class="programs-heading-line programs-heading-line-two" src="/u-point/layers/figma-programs-heading.png" alt="" />
          </div>
          <article class="program-card voucher-card">
            <div class="voucher-card-copy">
              <h3>Voucher tiền mặt (Cash) &amp; Promo</h3>
              <p><strong>Đổi điểm lấy voucher của 450++ thương hiệu</strong> với giá giảm tối đa 10-20% tùy từng thời điểm.</p>
              <p>Các bộ sưu tập voucher được cập nhật liên tục với giá ưu đãi siêu hời</p>
            </div>
            <img class="voucher-logos" src="/u-point/layers/extracted/voucher-logos.png" alt="Các thương hiệu áp dụng voucher" />
            <img class="voucher-collections" src="/u-point/layers/extracted/voucher-collections.png" alt="Các bộ sưu tập voucher OneU" />
          </article>
          <article class="program-card sale-card">
            <img src="/u-point/layers/extracted/sale-artwork.png" alt="Sale sập sàn duy nhất thứ 4" />
            <div><h3>MEGA SALE/BRAND DAY</h3><p><strong>Ngày sale độc quyền</strong> với loạt voucher promo đổi với 01 U-Point &amp; cash voucher đổi U-Point chỉ từ 20 - 50% giá</p></div>
          </article>
          <article class="program-card atvn-card">
            <img src="/u-point/layers/figma-atvn-full.png?v=1" alt="Anh Trai Vượt Ngàn Chông Gai" />
            <div><h3>Anh Trai Vượt Ngàn Chông Gai</h3><p><strong>Bộ collection độc quyền</strong> dành riêng cho “Gai con”</p></div>
          </article>
        </section>

        <section class="link-section">
          <img class="heading-image link-title" src="/u-point/layers/figma-link-title.png" alt="Liên kết tài khoản" />
          <div class="link-subtitle">GIỮA TECHCOMBANK MOBILE - ONEU</div>
          <ul class="link-copy">
            <li>Đồng bộ hồ sơ điểm U-Point giữa nền tảng ngân hàng <small>(Techcombank Mobile) và ứng dụng phong cách sống (TCB OneU)</small></li>
            <li>Trải nghiệm liền mạch và linh hoạt tiêu điểm U-Point trên các tính năng của cả TCB Rewards &amp; TCB OneU</li>
          </ul>
          <img class="link-steps" src="/u-point/layers/transparent/link-steps.png?v=4" alt="Các bước liên kết tài khoản Techcombank Mobile và OneU" />
        </section>
      </article>
    </div>
    <section class="desktop-note" aria-label="Lưu ý sử dụng điểm U-Point"><strong>Lưu ý:</strong><br />Thời hạn sử dụng điểm: 12 tháng (kể từ ngày phát hành / ngày cuối cùng của tháng)<br />Điểm không được chuyển đổi thành tiền mặt, thừa kế, chuyển nhượng</section>

    <div class="mobile-shell artboard-shell">
      <article class="mobile-artboard artboard" aria-label="Hướng dẫn sử dụng U-Point trên thiết bị di động">
        <section class="mobile-hero">
          <img class="mobile-hero-bg" src="/u-point/layers/hero-background.png" alt="" />
          <img class="mobile-title" src="/u-point/layers/extracted/mobile-hero-title.png?v=3" alt="Hướng dẫn sử dụng U-Point và đặc quyền thành viên Allstar" />
          <div class="mobile-subtitle">TRÊN ỨNG DỤNG TECHCOMBANK ONEU</div>
        </section>
        <div class="mobile-divider"></div>

        <section class="mobile-oneu">
          <img class="mobile-section-heading mh-oneu" src="/u-point/layers/extracted/mobile-oneu-heading.png?v=3" alt="Giao diện App Techcombank OneU và thông tin điểm" />
          <img class="m-oneu-callout-group" src="/u-point/layers/extracted/mobile-oneu-callout-group.png?v=1" alt="Giao diện OneU với kho voucher, các tính năng và chương trình ưu đãi" />
          <h3 class="m-oneu-title m-oneu-title-1"><span>01</span> Kho voucher và Số dư U-point</h3>
          <img class="m-voucher-screen" src="/u-point/layers/mobile-voucher.png?v=8" alt="Kho voucher" />
          <p class="m-voucher-copy">Kho lưu trữ các loại voucher KH đã đổi điểm/ thu thập miễn phí hoặc voucher được tặng</p>
          <img class="m-points-screen" src="/u-point/layers/mobile-points.png?v=8" alt="Số dư U-Point" />
          <ul class="m-points-copy"><li>Thể hiện số U-point ở cả 2 nguồn TCB &amp; OneU</li><li>Khi truy cập dẫn đến màn <strong>Số dư điểm, Quản lý Điểm &amp; Lịch sử giao dịch điểm</strong></li></ul>
          <div class="m-route m-route-left"><h3><span>02</span> Đường dẫn truy cập các tính năng &amp; collection</h3><ul><li>Tính năng đặt món</li><li>Collections “Voucher siêu thị”, “Voucher HOT”,...</li><li>Tất cả tiện ích</li></ul></div>
          <div class="m-route m-route-right"><h3><span>03</span> Các chương trình ưu đãi theo từng thời kì</h3></div>
        </section>

        <section class="mobile-pnp-section">
          <div class="mh-pnp-mask"><img class="mobile-section-heading mh-pnp" src="/u-point/layers/extracted/mobile-pnp-heading.png?v=3" alt="Giao diện PNP đặc quyền" /></div>
          <img class="mp-phone-a" src="/u-point/layers/transparent/pnp-phone-right.png?v=4" alt="Đặc quyền Allstar" />
          <img class="mp-phone-b" src="/u-point/layers/transparent/pnp-phone-left.png?v=4" alt="Đặc quyền Allstar" />
          <p class="mp-copy-left">Chọn “<strong>Đặc quyền hội viên Techcombank Private &amp; Priority</strong>” để khám phá những voucher, ưu đãi dành riêng cho thành viên Allstar Club.</p>
          <i class="mp-callout mp-callout-left" aria-hidden="true"></i>
          <i class="mp-callout mp-callout-right" aria-hidden="true"></i>
          <p class="mp-copy-right"><strong>Giao diện dành cho VIP, khám phá vô vàn ưu đãi từ các hạng mục:</strong> Hàng hiệu, Mua sắm, Ẩm thực,...</p>
          <a class="mp-cta" href="https://s.oneu.vn/dlp_pnp" target="_blank" rel="noopener noreferrer">Trải nghiệm ngay</a>
        </section>

        <section class="mobile-features-section">
          <img class="mobile-section-heading mh-features" src="/u-point/layers/extracted/mobile-features-heading.png?v=3" alt="Các tính năng trên app Techcombank OneU" />
          <div class="m-feature-grid">
            {features.map((feature) => (
              <article class="m-feature"><img src={`/u-point/layers/transparent/${feature.icon}?v=4`} alt="" /><div><h3>{feature.title}</h3><p>{feature.copy}</p></div></article>
            ))}
          </div>
        </section>

        <section class="mobile-programs-section">
          <article class="m-program m-voucher-card">
            <h3>Voucher tiền mặt (Cash) &amp; Promo</h3>
            <p><strong>Đổi điểm lấy voucher của 450++ thương hiệu</strong> với giá giảm tối đa 10-20% tùy từng thời điểm.</p>
            <p class="m-voucher-update">Các bộ sưu tập voucher được cập nhật liên tục với giá ưu đãi siêu hời</p>
            <img class="m-voucher-logos" src="/u-point/layers/extracted/voucher-logos.png" alt="Các thương hiệu áp dụng voucher" />
            <img class="m-voucher-collections" src="/u-point/layers/extracted/voucher-collections.png" alt="Các bộ sưu tập voucher OneU" />
          </article>
          <article class="m-program m-sale-card"><img src="/u-point/layers/extracted/sale-artwork.png" alt="Sale sập sàn duy nhất thứ 4" /><div><h3>MEGA SALE/BRAND DAY</h3><p><strong>Ngày sale độc quyền</strong> với loạt voucher promo đổi bằng U-Point.</p></div></article>
          <article class="m-program m-atvn-card"><img src="/u-point/layers/extracted/atvn-artwork.png?v=2" alt="Anh Trai Vượt Ngàn Chông Gai" /><div><p><strong>Bộ collection độc quyền</strong> dành riêng cho “Gai con”</p></div></article>
        </section>

        <section class="mobile-link-section">
          <div class="mh-link-mask"><img class="mobile-section-heading mh-link" src="/u-point/layers/extracted/desktop-link-heading.png?v=1" alt="Liên kết tài khoản" /></div>
          <ul class="m-link-copy">
            <li><strong>Đồng bộ hệ điểm U-Point giữa nền tảng ngân hàng</strong> (Techcombank Mobile) và ứng dụng phong cách sống (TCB OneU)</li>
            <li><strong>Trải nghiệm liền mạch và linh hoạt tiêu điểm U-Point trên các tính năng</strong> của cả TCB Rewards &amp; TCB OneU</li>
          </ul>
          <img class="m-link-steps" src="/u-point/layers/transparent/link-steps.png?v=4" alt="Các bước liên kết tài khoản" />
          <div class="m-note"><strong>Lưu ý:</strong> Thời hạn sử dụng điểm: 12 tháng. Điểm không được chuyển đổi thành tiền mặt, thừa kế, chuyển nhượng.</div>
        </section>
      </article>
    </div>
  </main>
  <Footer />

  <script is:inline>
    (() => {
      const resize = () => {
        const mobile = window.innerWidth < 768;
        const baseWidth = mobile ? 320 : 1440;
        const baseHeight = mobile ? 3483 : 6704;
        const shell = document.querySelector(mobile ? '.mobile-shell' : '.desktop-shell');
        if (!shell) return;
        const scale = mobile ? window.innerWidth / baseWidth : Math.min(window.innerWidth / baseWidth, 1);
        shell.style.setProperty('--artboard-scale', String(scale));
        document.documentElement.style.setProperty('--u-point-desktop-scale', String(scale));
        shell.style.height = `${baseHeight * scale}px`;
      };
      resize();
      window.addEventListener('resize', resize, { passive: true });
    })();
  </script>

  <style>
    :global(html) { background: #17239a; }
    :global(body.u-point-page) { margin: 0; overflow-x: hidden; background: #17239a; color: #fff; font-family: Manrope, sans-serif; font-weight: 400; }
    :global(body.u-point-page nav), :global(body.u-point-page #mobile-menu) { font-family: Manrope, sans-serif; }
    .u-point-main { padding-top: 80px; min-height: 100vh; background: linear-gradient(180deg, #273ec5 0%, #293fc5 45%, #201b9a 100%); }
    .artboard-shell { position: relative; margin: 0 auto; overflow: hidden; }
    .artboard { position: absolute; top: 0; left: 50%; transform: translateX(-50%) scale(var(--artboard-scale, 1)); transform-origin: top center; overflow: hidden; font-family: Manrope, sans-serif; font-weight: 400; font-optical-sizing: auto; color: #fff; }
    .desktop-shell { display: block; width: 100%; height: 6704px; }
    /* The hero artwork belongs to the viewport; only its content is constrained to the 1440px artboard. */
    .desktop-shell::before {
      content: ''; position: absolute; z-index: 0; inset: 0 0 auto; width: 100%;
      height: calc(603px * var(--artboard-scale, 1));
      background:
        linear-gradient(90deg, rgba(0, 24, 133, .72), rgba(4, 52, 190, .18) 52%, rgba(0, 31, 147, .5)),
        url('/u-point/layers/hero-background.png') center / 100% 100% no-repeat;
    }
    .desktop-shell::after {
      content: ''; position: absolute; z-index: 2; left: 0; top: calc(591px * var(--artboard-scale, 1)); width: 100%;
      height: calc(12px * var(--artboard-scale, 1));
      background: linear-gradient(90deg, #ed3148 0%, #ff6b40 19%, #f5b648 48%, #526ed7 100%);
      pointer-events: none;
    }
    .desktop-artboard { z-index: 1; width: 1440px; height: 6704px; overflow: visible; background: transparent; }
    .desktop-artboard .hero-bg, .desktop-artboard .hero::after, .desktop-artboard .section-divider { display: none; }
    .mobile-shell { display: none; }
    .heading-image { position: absolute; display: block; object-fit: fill; }

    .hero { position: absolute; inset: 0 0 auto; height: 603px; overflow: visible; }
    .hero::after {
      content: ''; position: absolute; left: 50%; top: 0; width: calc(100vw / var(--artboard-scale, 1)); height: 603px;
      transform: translateX(-50%); background: linear-gradient(90deg, rgba(0, 24, 133, .72), rgba(4, 52, 190, .18) 52%, rgba(0, 31, 147, .5)); pointer-events: none;
    }
    .hero-bg {
      position: absolute; left: 50%; top: 0; width: calc(100vw / var(--artboard-scale, 1)); height: 603px;
      transform: translateX(-50%); object-fit: fill; opacity: .84;
    }
    .hero-title, .hero-subtitle { z-index: 1; }
    .hero-title { left: 54px; top: 204px; width: 977px; height: 147px; }
    .hero-subtitle {
      position: absolute; left: 54px; top: 361px; width: 724px; height: 60px;
      display: flex; align-items: center; box-sizing: border-box; padding: 0 35px;
      background: linear-gradient(90deg, #d5103d 0%, rgba(190, 18, 65, .96) 29%, rgba(87, 25, 119, .74) 61%, rgba(17, 53, 159, 0) 100%);
      color: #fff; font: 700 28px/1.2 Manrope, sans-serif; letter-spacing: 1.4px;
      text-shadow: 0 2px 5px rgba(0, 0, 0, .42); white-space: nowrap;
    }
    .section-divider {
      position: absolute; left: 50%; top: 591px; width: calc(100vw / var(--artboard-scale, 1)); height: 12px;
      transform: translateX(-50%); background: linear-gradient(90deg, #ed3148 0%, #ff6b40 19%, #f5b648 48%, #526ed7 100%);
    }

    .oneu-section { position: absolute; left: 0; top: 0; width: 1440px; height: 1825px; }
    .oneu-heading { left: 276px; top: 663px; width: 864px; height: 102px; object-fit: contain; }
    .main-phone { position: absolute; left: 120px; top: 830px; width: 362px; height: 729px; object-fit: contain; }
    .info-pill, .route-block h3 { margin: 0; box-sizing: border-box; border: 1.5px solid #e7b665; border-radius: 28px; background: linear-gradient(105deg, rgba(54, 40, 139, .96), rgba(35, 31, 111, .9)); font-weight: 700; }
    .voucher-pill { position: absolute; left: 579px; top: 830px; width: 487px; height: 61px; display: flex; align-items: center; justify-content: center; font-size: 26px; }
    .voucher-screen { position: absolute; left: 569px; top: 939px; width: 251px; height: 457px; object-fit: contain; object-position: top; }
    .voucher-copy { position: absolute; left: 571px; top: 1415px; width: 299px; margin: 0; font-size: 22px; font-weight: 400; line-height: 1.28; }
    .points-screen { position: absolute; left: 939px; top: 939px; width: 288px; height: 457px; object-fit: contain; object-position: top; }
