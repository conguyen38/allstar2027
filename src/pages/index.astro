---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroLoader from '../components/IntroLoader.astro';


const title = "Allstar Club - Chương trình Loyalty lực lượng bán Techcombank & OneHousing";
const description = "Allstar Club là chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing. Khám phá các chương trình PRM Techcombank và LLB OneHousing để nhận thưởng U-Point hấp dẫn.";
---

<BaseLayout title={title} description={description} canonicalPath="/" bodyClass="club-entry">
  <Fragment slot="head">
<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Allstar Club",
    "url": "https://allstar26.vercel.app/",
    "description": "Chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing",
    "publisher": {
      "@type": "Organization",
      "name": "OneHousing",
      "logo": {
        "@type": "ImageObject",
        "url": "https://allstar26.vercel.app/assets/images/allstar-27.webp"
      }
    }
  }
  </script>
    <link rel="preload" as="image" href="/assets/images/allstar-home-saigon-illustrated.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet" />
  </Fragment>
  <IntroLoader />
  <main class="club-cover home-cover">
    <img class="club-scene" src="/assets/images/allstar-home-saigon-illustrated.webp" alt="" fetchpriority="high" width="1672" height="941" />
    <video class="home-video" autoplay muted loop playsinline preload="auto" aria-hidden="true" poster="/assets/images/allstar-home-saigon-illustrated.webp">
      <source src="/assets/images/allstar-home-river-new-loop.mp4" type="video/mp4" />
    </video>
    <div class="club-caption">
      <h1 class="home-logo"><img class="club-wordmark" src="/assets/images/allstar-27.webp" alt="Allstar Club" width="1024" height="872" /><span class="home-logo-light" aria-hidden="true"></span></h1>
      <p class="club-programs-prompt">Vui lòng chọn chương trình phù hợp</p>
      <nav class="club-programs" aria-label="Chọn chương trình">
        <a href="/prm/"><strong>PRM Techcombank</strong></a>
        <a href="/sih/"><strong>LLB OneHousing</strong></a>
      </nav>
    </div>
  </main>
  <script is:inline>
    (() => {
      const video = document.querySelector('.home-video');
      if (!video) return;
      video.muted = true;
      video.defaultMuted = true;
      const play = () => {
        if (!document.hidden) video.play().catch(() => {});
      };
      video.addEventListener('playing', () => video.classList.add('is-playing'));
      video.addEventListener('error', () => video.classList.remove('is-playing'));
      video.addEventListener('canplay', play, { once: true });
      document.addEventListener('visibilitychange', play);
      document.addEventListener('pointerdown', play, { once: true });
      play();
    })();
  </script>
</BaseLayout>
