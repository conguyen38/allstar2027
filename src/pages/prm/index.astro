---
import SunsetBanner from '../../components/SunsetBanner.astro';
import ProgramLayout from '../../layouts/ProgramLayout.astro';

const title = "Allstar Club - Chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing";
const description = "Allstar Club là chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing. Ghi điểm qua GMV bán dự án Premium, Branded và các hoạt động trên OneHub để nhận thưởng hấp dẫn.";

const milestones = [
  { points: 10, bonus: 5, total: 5 },
  { points: 18, bonus: 8, total: 13 },
  { points: 32, bonus: 12, total: 25 },
  { points: 80, bonus: 40, total: 65 },
  { points: 150, bonus: 32, total: 97 },
  { points: 320, bonus: 68, total: 165 },
  { points: 680, bonus: 138, total: 303 },
];
---

<ProgramLayout
  title={title}
  description={description}
  canonicalPath="/prm/"
  program="prm"
  active="index"
  bodyClass="page-bg text-on-surface font-body selection:bg-primary/30 selection:text-primary overflow-x-hidden"
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&display=swap" rel="stylesheet" />
<script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Allstar Club - OneHousing",
      "url": "https://allstar2027.vercel.app/prm/",
      "description": "Chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing",
      "publisher": {
        "@type": "Organization",
        "name": "OneHousing",
        "logo": {
          "@type": "ImageObject",
          "url": "https://allstar2027.vercel.app/assets/images/allstar-27.webp"
        }
      }
    }
    </script>
<style type="text/css">
        .glass-card {
            background: linear-gradient(145deg, rgba(85, 42, 85, 0.82), rgba(52, 30, 62, 0.74));
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(255, 141, 180, 0.34);
            border-left: 1px solid rgba(255, 141, 180, 0.24);
            box-shadow: inset 0 1px 0 rgba(255, 220, 205, 0.08), 0 18px 48px rgba(51, 30, 60, 0.26);
        }


        /* Keep a single, predictable rhythm between each homepage content block. */
        .home-content-section {
            padding-top: 0;
            padding-bottom: 0;
        }

        .home-content-section + .home-content-section {
            margin-top: 5rem;
        }

        @media (max-width: 767px) {
            .home-content-section + .home-content-section {
                margin-top: 4rem;
            }
        }


        .hero-banner {
            background-image: url('/assets/images/allstar-sunset.webp');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .hero-overlay {
            background: linear-gradient(to bottom, rgba(17, 10, 20, 0.8) 0%, rgba(17, 10, 20, 0.2) 50%, rgba(17, 10, 20, 0.8) 100%);
        }

        /* Specific styles for the requested milestone table */
        .milestone-table-row:last-child {
            background: linear-gradient(90deg, rgba(255, 183, 132, 0.05), rgba(255, 141, 180, 0.05));
        }

        /* Table responsive */
        @media (max-width: 767px) {
            .milestone-table-cell-pad {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        /* ── Page background & Neon trails ── */
        :global(body.page-bg) {
            background:
                radial-gradient(ellipse 72% 42% at 50% 10%, rgba(128, 63, 128, 0.38), transparent 72%),
                radial-gradient(ellipse 54% 34% at 100% 70%, rgba(255, 141, 180, 0.09), transparent 74%),
                linear-gradient(rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(135deg, #311c3a 0%, #24152b 48%, #2b1932 100%);
            background-size: auto, auto, 72px 72px, 72px 72px, auto;
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* Same surface as the content background: the pinned hero can dissolve into it without a hard edge. */
        .hero-page-fade {
            background:
                radial-gradient(ellipse 72% 42% at 50% 10%, rgba(128, 63, 128, 0.38), transparent 72%),
                radial-gradient(ellipse 54% 34% at 100% 70%, rgba(255, 141, 180, 0.09), transparent 74%),
                linear-gradient(rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(135deg, #311c3a 0%, #24152b 48%, #2b1932 100%);
            background-size: auto, auto, 72px 72px, 72px 72px, auto;
            background-attachment: fixed;
        }

        .trails-svg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.72;
        }

        @keyframes trail-move {
            0% {
                stroke-dashoffset: 1000;
                opacity: 0;
            }

            20% {
                opacity: 1;
            }

            80% {
                opacity: 0.6;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0;
            }
        }

        .trail-line {
            stroke-dasharray: 400 600;
            animation: trail-move 6s linear infinite;
        }

        .trail-line:nth-child(2) {
            animation-delay: 1.5s;
            animation-duration: 7s;
        }

        .trail-line:nth-child(3) {
            animation-delay: 3s;
            animation-duration: 5.5s;
        }

        .trail-line:nth-child(4) {
            animation-delay: 0.8s;
            animation-duration: 8s;
        }

        .trail-line:nth-child(5) {
            animation-delay: 2.2s;
            animation-duration: 6.5s;
        }
    </style>
  </Fragment>

  <Fragment slot="beforeHeader">
<!-- Neon light trails -->
    <svg class="trails-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <line class="trail-line" x1="-100" y1="200" x2="1540" y2="180" stroke="rgba(255, 141, 180,0.4)" stroke-width="1" />
        <line class="trail-line" x1="-100" y1="450" x2="1540" y2="420" stroke="rgba(255, 196, 153,0.35)"
            stroke-width="0.8" />
        <line class="trail-line" x1="-100" y1="680" x2="1540" y2="700" stroke="rgba(255, 141, 180,0.3)"
            stroke-width="1.2" />
        <line class="trail-line" x1="200" y1="-50" x2="180" y2="950" stroke="rgba(255, 141, 180,0.25)" stroke-width="0.8" />
        <line class="trail-line" x1="1100" y1="-50" x2="1120" y2="950" stroke="rgba(255, 196, 153,0.2)"
            stroke-width="1" />
    </svg>
    <!-- TopNavBar -->
  </Fragment>

<main class="pt-20 program-info">
        <!-- Hero Banner -->
        <SunsetBanner program="prm" />
        <!-- Cách thức ghi điểm -->
        <section class="home-content-section pt-16 px-4 md:px-8 max-w-7xl mx-auto">
            <div class="mb-10 md:mb-16">
                <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-3" style="">Ghi điểm qua
                    GMV bán Dự án</h2>
                <p class="text-white font-label font-normal text-sm" style="">Với mỗi 1
                    tỷ GMV đạt được (giá trước VAT & KPBT) & 1 điểm = 1Tr U-Point</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
                <!-- Card 1: Dự án Premium -->
                <div
                    class="score-card">
                    <h3 class="score-card__label">
                        Dự án Premium
                    </h3>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Cá nhân</span>
                            <span class="font-bold text-primary text-lg" style="">1 điểm</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Chi nhánh</span>
                            <span class="font-bold text-primary text-lg" style="">0.5 điểm</span>
                        </div>
                    </div>
                </div>
                <!-- Card 2: Dự án Branded -->
                <div
                    class="score-card">
                    <h3 class="score-card__label">
                        Dự án Branded
                    </h3>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Cá nhân (LLTV)</span>
                            <span class="font-bold text-primary text-lg" style="">0.8 điểm</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Cá nhân (PM/Headhub)</span>
                            <span class="font-bold text-primary text-lg" style="">0.2 điểm</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Chi nhánh</span>
                            <span class="font-bold text-primary text-lg" style="">0.5 điểm</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- section: Ghi điểm qua hình thức khác -->
        <section class="home-content-section px-4 md:px-8 max-w-7xl mx-auto">
            <div class="mb-10 md:mb-16">
                <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-3" style="">Ghi điểm qua
                    hình thức khác</h2>
                <p class="text-white font-label font-normal text-sm" style="">Khuyến
                    khích LLTV tham gia các hoạt động tăng tích lũy điểm</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
                <!-- Card 3: Refer to OneTrust -->
                <div
                    class="score-card">

                    <h3 class="score-card__label">
                        Refer căn chuyển nhượng cho OneTrust
                    </h3>
                    <p class="text-white text-sm font-medium mb-2" style="">Mỗi 1 tỷ GMV (NET) được chốt sẽ quy đổi:
                    </p>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">LLTV</span>
                            <span class="font-bold text-primary text-lg" style="">1 điểm</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Chi nhánh</span>
                            <span class="font-bold text-primary text-lg" style="">0.5 điểm</span>
                        </div>
                    </div>
                    <p class="text-white text-sm font-medium mb-2" style="">Các dự án ghi nhận: Cao tầng OCP1 và Cao
                        tầng/Thấp tầng Cổ Loa
                    </p>
                </div>
                <!-- Card 4: OneHub activities -->
                <div
                    class="score-card">

                    <h3 class="score-card__label">
                        Hoạt động trên OneHub
                    </h3>
                    <p class="text-white text-sm font-medium mb-2" style="">Mỗi hoạt động trên nền tảng OneHub sẽ quy
                        đổi:
                    </p>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">LLTV Kích hoạt tài khoản</span>
                            <span class="font-bold text-primary text-lg" style="">0.1 điểm</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Niêm yết OneHub thỏa 2K4D</span>
                            <span class="font-bold text-primary text-lg" style="">0.5 điểm</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-white/70 text-sm font-medium" style="">Giao dịch OneHub</span>
                            <span class="font-bold text-primary text-lg" style="">0.5 điểm</span>
                        </div>
                    </div>
                    <p class="text-white text-sm font-medium mb-2" style="">Các dự án ghi nhận: Cao tầng OCP1,2,3 và
                        Ecopark
                    </p>
                </div>
            </div>
        </section>
        <!-- Bảng mốc thưởng -->
        <section class="home-content-section">
            <div class="max-w-7xl mx-auto px-4 md:px-8">
                <div class="mb-8 md:mb-12 flex flex-wrap justify-between items-end gap-4">
                    <div>
                        <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-3" style="">Bảng
                            mốc thưởng</h2>
                        <p class="text-white font-label font-normal text-sm" style="">
                            Điểm bonus sẽ được cộng dồn
                            khi đạt các mốc điểm tương ứng của chương trình.</p>
                    </div>
                    <!-- <button class="text-primary font-label font-bold flex items-center gap-2 hover:gap-3 transition-all" style="">
                    Xem chi tiết <span class="material-symbols-outlined" style="">arrow_forward</span>
</button> -->
                </div>
                <div class="reward-card">
                    <table aria-label="Bảng mốc thưởng">
                        <thead><tr><th scope="col">Mốc điểm</th><th scope="col">Bonus</th><th scope="col">Tổng bonus</th></tr></thead>
                        <tbody>
                            {milestones.map(({ points, bonus, total }) => (
                                <tr><th scope="row">{points}</th><td>+{bonus}</td><td>{total}</td></tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        <!-- QnA Accordion -->
        <section class="home-content-section px-4 md:px-8 max-w-4xl mx-auto" style="padding-bottom: clamp(7rem, 14vw, 10rem);">
            <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-10 md:mb-16 text-center">Câu
                hỏi thường gặp</h2>
            <div id="faq-accordion" class="flex flex-col gap-3"></div>
        </section>
        <script is:inline>
            var faqData = [
                {
                    title: "Điểm được ghi nhận như thế nào?",
                    body: [
                        "Điểm <strong>tạm tính</strong> được ghi nhân tại thời điểm ráp căn thành công <strong>(HBK - OTP)</strong>.",
                        "Điểm sẽ bị <strong>thu hồi</strong> nếu giao dịch không chuyển đổi thành HĐMB."
                    ]
                },
                {
                    title: "Có thể rút quỹ thưởng bất kì lúc nào không? Thời gian chi trả là khi nào?",
                    body: [
                        "<strong>Không</strong>, việc chi trả thực tế sẽ dựa theo kỳ chi dự kiến nêu trong thể lệ, phụ thuộc vào thời gian hoàn tất <strong>HĐMB</strong>."
                    ]
                },
                {
                    title: "Xem điểm thưởng ở đâu?",
                    body: [
                        "Điểm thưởng sẽ được cập nhật <strong>real-time</strong> ở mục <strong>Bảng xếp hạng</strong> trên website chương trình, theo miền LLTV."
                    ]
                },
                {
                    title: "LLTV làm ở chi nhánh A đến hết T3.2026 rồi chuyển sang chi nhánh B, vậy 20% điểm cá nhân của LLTV sẽ được tính theo chi nhánh nào?",
                    body: [
                        "Điểm (bao gồm phần tạm khóa) sẽ ghi nhận cho <strong>Chi nhánh A</strong> tính đến giao dịch cuối cùng trước khi chuyển. Các giao dịch sau đó sẽ tính cho <strong>Chi nhánh B</strong>."
                    ]
                },
                {
                    title: "Nếu LLTV bán cả dự án miền Bắc và miền Nam, điểm sẽ được tính như thế nào?",
                    body: [
                        "Điểm sẽ được tính theo <strong>miền của lực lượng tư vấn</strong>, điểm sẽ vẫn được cộng theo cơ chế chung, không theo miền dự án."
                    ]
                },
                {
                    title: "LLTV có thể tra số dư điểm thưởng ở đâu?",
                    body: [
                        "LLTV vui lòng liên hệ <strong>PNS</strong> đang phụ trách tại Chi nhánh hoặc liên hệ BTC qua hotline: <strong>Bùi Bích Phương - 0917701043</strong>"
                    ]
                },
                {
                    title: "LLTV có thể gửi câu hỏi hoặc đóng góp ý kiến về chương trình qua kênh nào?",
                    body: [
                        "BTC tiếp nhận mọi câu hỏi và ý kiến đóng góp của LLTV thông qua <strong>Google Form chính thức</strong> của chương trình: <a href=\"https://forms.gle/xsMVxV681t2ha9Hk7\" target=\"_blank\" class=\"text-primary hover:underline\">https://forms.gle/xsMVxV681t2ha9Hk7</a>",
                        "LLTV vui lòng điền thông tin theo biểu mẫu để được hỗ trợ và phản hồi trong thời gian sớm nhất."
                    ]
                }
            ];

            function buildAccordion() {
                var container = document.getElementById("faq-accordion");
                if (!container) return;
                faqData.forEach(function (item, idx) {
                    var div = document.createElement("div");
                    div.className = "accordion-item";
                    div.innerHTML =
                        "<button class=\"accordion-trigger\" onclick=\"toggleAccordion(" + idx + ")\">" +
                        "<span>" + (idx + 1) + ". " + item.title + "</span>" +
                        "<span class=\"accordion-icon\">" +
                        "<svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">" +
                        "<path d=\"M2 4.5 7 9.5 12 4.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>" +
                        "</svg>" +
                        "</span>" +
                        "</button>" +
                        "<div class=\"accordion-body\"><div class=\"accordion-content\" id=\"faq-content-" + idx + "\"></div></div>";
                    container.appendChild(div);
                    renderAccordionContent(idx);
                });
                var first = document.querySelector(".accordion-item");
                if (first) first.classList.add("is-open");
            }

            function renderAccordionContent(idx) {
                var data = faqData[idx];
                var el = document.getElementById("faq-content-" + idx);
                if (!el) return;
                var html = data.body.map(function (p) { return "<p>" + p + "</p>"; }).join("");
                if (data.formula) {
                    html += "<div class=\"mt-4 rounded-xl border border-white/10 bg-white/5 px-6 py-5 text-center\">"
                        + "<p class=\"text-white/50 text-xs uppercase  mb-3\">C\u00f4ng th\u1ee9c c\u01a1 b\u1ea3n</p>"
                        + "<div class=\"inline-flex flex-col items-center gap-1\">"
                        + "<span class=\"text-white font-bold text-base\">Gi\u00e1 tr\u1ecb 1 \u0111i\u1ec3m</span>"
                        + "<span class=\"text-white/40 text-lg\">=</span>"
                        + "<div class=\"flex flex-col items-center\">"
                        + "<span class=\"border-b border-white/30 pb-1 mb-1 text-sm text-white/80 font-semibold px-2\">T\u1ed5ng gi\u00e1 tr\u1ecb qu\u1ef9 th\u01b0\u1edfng</span>"
                        + "<span class=\"text-sm text-white/80 font-semibold px-2\">T\u1ed5ng \u0111i\u1ec3m to\u00e0n l\u1ef1c l\u01b0\u1ee3ng</span>"
                        + "</div>"
                        + "<span class=\"text-white/40 text-lg\">&#215;</span>"
                        + "<span class=\"text-primary font-bold text-base\">H\u1ec7 s\u1ed1 LLTV <span class=\"text-white/60\">(0.5)</span></span>"
                        + "</div>"
                        + "</div>";
                }
                if (data.image) {
                    html += "<div class=\"mt-4 rounded-xl overflow-hidden border border-white/10\">"
                        + "<img src=\"" + data.image + "\" alt=\"\" class=\"w-full h-auto object-cover\" loading=\"lazy\">"
                        + "</div>";
                }
                el.innerHTML = html;
            }

            function toggleAccordion(idx) {
                document.querySelectorAll(".accordion-item").forEach(function (item, i) {
                    if (i === idx) { item.classList.toggle("is-open"); }
                    else { item.classList.remove("is-open"); }
                });
            }

            buildAccordion();
        </script>
    </main>
    <!-- Footer -->

<script is:inline>


        /* ────────────────── Active nav sync ────────────────── */
        function setActiveNav() {
            var filename = window.location.pathname.split('/').filter(Boolean).pop() || 'index.html';
            if (filename.indexOf('.') === -1 && filename !== 'index.html') filename += '.html';
            var map = {
                'index.html': 'index', 'index': 'index', '': 'index',
                'tong-quan-chuong-trinh.html': 'tong-quan', 'tong-quan-chuong-trinh': 'tong-quan',
                'the-le.html': 'the-le', 'the-le': 'the-le',
                'leaderboard-prm.html': 'bxh', 'leaderboard-prm': 'bxh',
                'refer-onetrust.html': 'refer', 'refer-onetrust': 'refer',
            };
            var active = map[filename] || 'index';
            document.querySelectorAll('[data-nav]').forEach(function (el) {
                if (el.dataset.nav === active) {
                    el.classList.add('nav-active');
                } else {
                    el.classList.remove('nav-active');
                }
            });
        }
        setActiveNav();
    </script>
    
<script>import '../../scripts/hero-intro';
import '../../scripts/hero-fade';</script>
</ProgramLayout>
