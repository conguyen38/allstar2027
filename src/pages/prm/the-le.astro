---
import ProgramLayout from '../../layouts/ProgramLayout.astro';

const title = "Thể Lệ Chương Trình Allstar Club - OneHousing";
const description = "Chi tiết thời gian ghi nhận và chi trả thưởng, cách thức tính điểm U-Point và tỷ lệ chi trả 80/20 của chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing.";
---

<ProgramLayout
  title={title}
  description={description}
  canonicalPath="/prm/the-le/"
  program="prm"
  active="the-le"
  bodyClass="page-bg text-on-surface font-body antialiased"
>
  <Fragment slot="head">
<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Thể Lệ Chương Trình Allstar Club",
    "description": "Thời gian ghi nhận, chi trả và cách thức tính điểm chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing",
    "publisher": {
      "@type": "Organization",
      "name": "OneHousing"
    }
  }
  </script>
<style>
    /* ── Hero ── */
    .hero-banner {
      background-image: url('/prm/assets/images/Herobanner1.webp');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .hero-overlay {
      background: linear-gradient(to bottom, rgba(10, 14, 20, 0.8) 0%, rgba(10, 14, 20, 0.2) 50%, rgba(10, 14, 20, 0.8) 100%);
    }

    @keyframes ray-pulse {

      0%,
      100% {
        opacity: 0.35;
      }

      50% {
        opacity: 0.7;
      }
    }

    .neon-ray {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-14px);
      }
    }

    @keyframes trophy-glow {

      0%,
      100% {
        filter: drop-shadow(0 0 28px rgba(255, 209, 108, 0.55)) drop-shadow(0 0 56px rgba(255, 160, 0, 0.28));
      }

      50% {
        filter: drop-shadow(0 0 56px rgba(255, 209, 108, 0.9)) drop-shadow(0 0 100px rgba(255, 160, 0, 0.5));
      }
    }

    .trophy-anim {
      animation: float 5s ease-in-out infinite, trophy-glow 3.5s ease-in-out infinite;
    }

    /* ── Sidebar ── */
    .sidebar-sticky {
      position: sticky;
      top: 6rem;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1rem;
      border-radius: 0.75rem;
      font-family: 'Open Sans', sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      color: rgba(241, 243, 252, 0.5);
      transition: all 0.2s;
      border-left: 2px solid transparent;
      text-decoration: none;
    }

    .sidebar-link:hover,
    .sidebar-link.active {
      color: #ffd16c;
      background: rgba(255, 209, 108, 0.07);
      border-left-color: #ffd16c;
      padding-left: 1.25rem;
    }

    .sidebar-num {
      font-size: 0.875rem;
      font-weight: 800;
      color: #ffd16c;
      background: rgba(255, 209, 108, 0.12);
      border-radius: 0.25rem;
      padding: 1px 5px;
      font-family: 'Open Sans', sans-serif;
    }

    /* ── White card (matches Cách thức ghi điểm) ── */
    .glass-card {
      background: rgba(32, 38, 47, 0.4);
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(68, 72, 79, 0.3);
      border-left: 1px solid rgba(68, 72, 79, 0.3);
    }

    /* ── Section heading ── */
    .sec-heading {
      font-family: 'Open Sans', sans-serif;
      font-weight: 800;
      font-size: 0.9rem;
      text-transform: uppercase;

      color: rgba(255, 255, 255, 0.9);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-bottom: 0.875rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: 1.5rem;
    }

    .sec-heading-bar {
      display: block;
      width: 4px;
      height: 1.1rem;
      background: linear-gradient(180deg, #ffd16c, #ff9500);
      border-radius: 9999px;
      flex-shrink: 0;
    }

    /* ── Tables ── */
    .data-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 0.875rem;
    }

    .data-table th {
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.6);
      font-family: 'Open Sans', sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.875rem;
      padding: 0.75rem 0.875rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .data-table td {
      padding: 0.75rem 0.875rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.9);
      vertical-align: middle;
      line-height: 1.5;
    }

    .data-table tr:last-child td {
      border-bottom: none;
    }

    .data-table tbody tr:hover td {
      background: rgba(255, 255, 255, 0.03);
    }

    .row-danger td {
      background: rgba(255, 113, 104, 0.05) !important;
      color: #ff7168 !important;
    }

    .row-danger td:first-child {
      border-left: 3px solid #ff7168;
    }

    .badge-th {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.5rem;
      padding: 2px 8px;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      font-weight: 800;
      font-family: 'Open Sans', sans-serif;
      text-transform: uppercase;
    }

    .badge-th1 {
      background: rgba(0, 227, 253, 0.15);
      color: #00e3fd;
    }

    .badge-th2 {
      background: rgba(255, 209, 108, 0.15);
      color: #ffd16c;
    }

    .badge-th3 {
      background: rgba(255, 113, 104, 0.15);
      color: #ff7168;
    }

    /* ── Misc ── */
    .info-box {
      background: rgba(0, 227, 253, 0.05);
      border: 1px solid rgba(0, 227, 253, 0.2);
      border-radius: 0.75rem;
      padding: 1rem 1.125rem;
    }

    .example-box {
      background: rgba(255, 209, 108, 0.05);
      border: 1px solid rgba(255, 209, 108, 0.2);
      border-radius: 0.75rem;
      padding: 1rem 1.125rem;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 12px;
      border-radius: 999px;
      font-size: 0.875rem;
      font-weight: 700;
      font-family: 'Open Sans', sans-serif;
    }

    .chip-gold {
      background: #1e293b;
      color: #fff;
    }

    .chip-cyan {
      background: #1e293b;
      color: #fff;
    }

    .chip-red {
      background: #1e293b;
      color: #fff;
    }

    .list-item {
      display: flex;
      gap: 0.875rem;
      align-items: flex-start;
      padding: 0.625rem 0;
      border-bottom: 1px solid #f3f4f6;
    }

    .list-item:last-child {
      border-bottom: none;
    }

    .list-num {
      flex-shrink: 0;
      width: 1.5rem;
      height: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #1e293b;
      color: #fff;
      border-radius: 50%;
      font-size: 0.875rem;
      font-weight: 800;
      font-family: 'Open Sans', sans-serif;
      margin-top: 1px;
    }

    @keyframes spin {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }


    /* ── Page background & Neon trails ── */
    .page-bg {
      background:
        radial-gradient(ellipse 80% 50% at 20% 20%, rgba(0, 80, 180, 0.18) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 10%, rgba(0, 227, 253, 0.1) 0%, transparent 50%),
        radial-gradient(ellipse 50% 60% at 50% 80%, rgba(80, 0, 180, 0.12) 0%, transparent 60%),
        #06091a;
      min-height: 100vh;
    }

    .trails-svg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.45;
    }

    @keyframes trail-move {
      0% {
        stroke-dashoffset: 1000;
        opacity: 0;
      }

      20% {
        opacity: 1;
      }

      80% {
        opacity: 0.6;
      }

      100% {
        stroke-dashoffset: 0;
        opacity: 0;
      }
    }

    .trail-line {
      stroke-dasharray: 400 600;
      animation: trail-move 6s linear infinite;
    }

    .trail-line:nth-child(2) {
      animation-delay: 1.5s;
      animation-duration: 7s;
    }

    .trail-line:nth-child(3) {
      animation-delay: 3s;
      animation-duration: 5.5s;
    }

    .trail-line:nth-child(4) {
      animation-delay: 0.8s;
      animation-duration: 8s;
    }

    .trail-line:nth-child(5) {
      animation-delay: 2.2s;
      animation-duration: 6.5s;
    }
  </style>
  </Fragment>

  <Fragment slot="beforeHeader">
<!-- Neon light trails -->
  <svg class="trails-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none"
    xmlns="http://www.w3.org/2000/svg">
    <line class="trail-line" x1="-100" y1="200" x2="1540" y2="180" stroke="rgba(0,227,253,0.4)" stroke-width="1" />
    <line class="trail-line" x1="-100" y1="450" x2="1540" y2="420" stroke="rgba(255,209,108,0.35)" stroke-width="0.8" />
    <line class="trail-line" x1="-100" y1="680" x2="1540" y2="700" stroke="rgba(0,100,255,0.3)" stroke-width="1.2" />
    <line class="trail-line" x1="200" y1="-50" x2="180" y2="950" stroke="rgba(0,227,253,0.25)" stroke-width="0.8" />
    <line class="trail-line" x1="1100" y1="-50" x2="1120" y2="950" stroke="rgba(255,209,108,0.2)" stroke-width="1" />
  </svg>
  </Fragment>

<main class="pt-20">

    <!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
    <section class="relative min-h-[300px] md:h-[400px] flex items-center justify-center overflow-hidden hero-banner">
      <!-- Overlay for better text readability -->
      <div class="absolute inset-0 z-0 hero-overlay"></div>

      <!-- Speed lines -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="speed-line" style="top:18%; width:280px; animation-delay:0s; opacity:0.6;"></div>
        <div class="speed-line" style="top:42%; width:320px; animation-delay:0.9s; opacity:0.7;"></div>
        <div class="speed-line" style="top:65%; width:240px; animation-delay:1.2s; opacity:0.5;"></div>
        <div class="speed-line"
          style="top:82%; width:300px; animation-delay:1.5s; opacity:0.5; background:linear-gradient(90deg,transparent,rgba(255,113,104,0.45),transparent);">
        </div>
      </div>

      <!-- Ambient glows -->
      <div
        class="absolute top-1/3 left-1/4 w-[400px] h-[400px] bg-[#ffd16c]/5 rounded-full blur-[120px] pointer-events-none">
      </div>
      <div
        class="absolute bottom-1/3 right-1/4 w-[300px] h-[300px] bg-[#00e3fd]/5 rounded-full blur-[100px] pointer-events-none">
      </div>

      <!-- Hero content — centered title only -->
      <div class="relative z-10 w-full px-4 flex items-center justify-center mt-10 md:mt-16">
        <h1
          class="font-headline font-bold text-white text-center uppercase text-[36px] leading-[1.3] md:text-[60px] md:leading-[1.1]"
          style="text-shadow: 0 2px 16px rgba(0,0,0,0.45);">
          THỂ LỆ
        </h1>
      </div>


    </section>

    <!-- ═══════════════════════════════ BODY ═══════════════════════════════ -->
    <section class="max-w-5xl mx-auto px-4 md:px-8 py-12 md:py-16 space-y-12">

      <!-- ─── SECTION I ─── -->
      <div id="sec-1">
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-6 font-headline flex items-center gap-3">
          <span class="w-1.5 h-8 bg-primary rounded-full"></span>
          I. Thời gian ghi nhận và chi trả
        </h2>
        <div class="glass-card p-6 md:p-10 rounded-3xl shadow-xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <!-- Thời gian ghi nhận -->
            <div class="info-box flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary mt-0.5 text-[22px]">calendar_today</span>
              <div>
                <p class="text-white/50 text-sm font-['Open_Sans'] uppercase tracking-wider mb-1">Thời gian ghi
                  nhận</p>
                <p class="text-white font-bold font-['Open_Sans'] text-base">01/02/2026 – 31/12/2026</p>
              </div>
            </div>
            <!-- Thời gian chi trả -->
            <div class="example-box flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-500 mt-0.5 text-[22px]">payments</span>
              <div>
                <p class="text-white/50 text-sm font-['Open_Sans'] uppercase tracking-wider mb-1">Thời gian chi
                  trả</p>
                <p class="text-primary font-bold font-['Open_Sans'] text-base">4 đợt trong năm</p>
              </div>
            </div>
          </div>

          <!-- Chi trả timeline -->
          <div class="overflow-x-auto rounded-xl">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Đợt</th>
                  <th>Kỳ ghi nhận</th>
                  <th>Ngày chi trả dự kiến</th>
                  <!-- <th>Ghi chú</th> -->
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="chip chip-gold">Đợt 1</span></td>
                  <td>Quý 1 · H1 (02–03/2026)</td>
                  <td class="font-bold font-['Open_Sans'] text-white">15/05/2026</td>
                  <!-- <td class="text-white/50">80% U-Point Q1</td> -->
                </tr>
                <tr>
                  <td><span class="chip chip-gold">Đợt 2</span></td>
                  <td>Quý 2 · H1 (04–06/2026)</td>
                  <td class="font-bold font-['Open_Sans'] text-white">15/08/2026</td>
                  <!-- <td class="text-white/50">80% U-Point Q2 + 20% tạm khóa H1 (nếu đủ ĐK)</td> -->
                </tr>
                <tr>
                  <td><span class="chip chip-gold">Đợt 3</span></td>
                  <td>Quý 3 · H2 (07–09/2026)</td>
                  <td class="font-bold font-['Open_Sans'] text-white">15/11/2026</td>
                  <!-- <td class="text-white/50">80% U-Point Q3 + giải tỏa H1 còn lại</td> -->
                </tr>
                <tr>
                  <td><span class="chip chip-gold">Đợt 4</span></td>
                  <td>Quý 4 · H2 (10–12/2026)</td>
                  <td class="font-bold font-['Open_Sans'] text-white">15/02/2027</td>
                  <!-- <td class="text-white/50">80% U-Point Q4 + 20% tạm khóa H2 (nếu đủ ĐK)</td> -->
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ─── SECTION II ─── -->
      <div id="sec-2">
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-6 font-headline flex items-center gap-3">
          <span class="w-1.5 h-8 bg-primary rounded-full"></span>
          II. Kênh áp dụng
        </h2>
        <div class="glass-card p-6 md:p-10 rounded-3xl shadow-xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-white/10 bg-white/5 p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="material-symbols-outlined text-green-400 text-[20px]">check_circle</span>
                <p class="text-white/90 font-['Open_Sans'] font-bold text-sm uppercase tracking-wider">Áp dụng
                  cho</p>
              </div>
              <ul class="space-y-2">
                <li class="flex items-start gap-2 text-sm text-white/80">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-400 mt-2 shrink-0"></span>
                  PNS - TCB, Quỹ chéo
                </li>
              </ul>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/5 p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="material-symbols-outlined text-tertiary text-[20px]">cancel</span>
                <p class="text-white/90 font-['Open_Sans'] font-bold text-sm uppercase tracking-wider">Ngoại trừ
                </p>
              </div>
              <ul class="space-y-2">
                <li class="flex items-start gap-2 text-sm text-white/80">
                  <span class="w-1.5 h-1.5 rounded-full bg-tertiary mt-2 shrink-0"></span>
                  Căn CBVN thuộc Hệ sinh thái
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      </div>

      <!-- ─── SECTION III ─── -->
      <div id="sec-3">
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-6 font-headline flex items-center gap-3">
          III. Điều kiện áp dụng
        </h2>
        <div class="glass-card p-6 md:p-10 rounded-3xl shadow-xl">
          <div class="space-y-4 mb-6">
            <div>
              <p class="text-sm text-white/70 leading-relaxed">
                <strong class="text-white">1.</strong> Áp dụng đối với <strong class="text-white">các căn
                  được ráp (HBK) trong thời gian từ 01/02/2026 đến
                  31/12/2026.</strong>
              </p>
            </div>
            <div>
              <p class="text-sm text-white/70 leading-relaxed">
                <strong class="text-white">2.</strong> Giá trị GMV tính thưởng là <strong class="text-white">giá trị căn
                  hộ trước VAT và KPBT (giá sau khi đối soát với CĐT).</strong>.
              </p>
            </div>
            <div>
              <p class="text-sm text-white/70 leading-relaxed">
                <strong class="text-white">3. Điểm tạm tính</strong>
                <br>- Được ghi nhận tại thời điểm ráp căn thành công (HBK – OTP).
                <br>- Điểm sẽ bị thu hồi nếu giao dịch không chuyển đổi thành HĐMB.
              </p>
            </div>
            <div>
              <p class="text-sm text-white/70 leading-relaxed">
                <strong class="text-white">4. Điểm chính thức</strong>
                <br>- Được ghi nhận khi căn đã chuyển đổi thành HĐMB.
                <br>- Đã được đối soát bởi CĐT.
              </p>
            </div>
            <div>
              <p class="text-sm text-white/70 leading-relaxed">
                <strong class="text-white">5.</strong> U-Point được quy đổi từ GMV NET và <strong class="text-white">làm
                  tròn đến 1 chữ số thập phân</strong> theo nguyên tắc làm tròn xuống.
              </p>
            </div>
          </div>

          <!-- Example box -->
          <div class="example-box flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-500 text-[20px] mt-0.5 shrink-0">lightbulb</span>
            <div>
              <p class="text-primary font-['Open_Sans'] font-bold text-sm uppercase tracking-wider mb-1">Ví dụ
                minh họa</p>
              <p class="text-sm text-white/70 leading-relaxed">
                GMV NET = <strong class="text-white">5.67 tỷ VNĐ</strong>
                &nbsp;→&nbsp;
                <strong class="text-tertiary">5.6 U-Point</strong>
                &nbsp;<span class="text-white/50">(làm tròn 1 chữ số thập phân, làm tròn xuống)</span>
              </p>
            </div>
          </div>
        </div>
      </div>
      </div>

      <!-- ─── SECTION IV ─── -->
      <div id="sec-4">
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-6 font-headline flex items-center gap-3">
          IV. Cách thức tính điểm và tỷ lệ chi trả
        </h2>
        <div class="glass-card p-6 md:p-10 rounded-3xl shadow-xl">
          <!-- Tỷ lệ tổng quan -->
          <div class="grid grid-cols-2 gap-3 mb-8">
            <div class="rounded-xl bg-white/5 border-white/10 p-4 text-center">
              <p class="text-4xl font-black font-['Open_Sans'] text-[#4ade80]">80%</p>
              <p class="text-sm text-white/60 mt-1 font-['Open_Sans'] uppercase tracking-wider">Chi trả theo kỳ
                chi trả gần nhất</p>
            </div>
            <div class="rounded-xl bg-white/5 border-white/10 p-4 text-center">
              <p class="text-4xl font-black font-['Open_Sans'] text-primary">20%</p>
              <p class="text-sm text-white/60 mt-1 font-['Open_Sans'] uppercase tracking-wider">Tạm khóa · Chi
                trả có điều kiện</p>
            </div>
          </div>

          <!-- Table 1: 80% khả dụng -->
          <div class="mb-8">
            <div class="flex items-center gap-2 mb-3">
              <p class="text-sm font-bold text-white/80 font-['Open_Sans'] uppercase"><strong
                  class="text-white">1.</strong> 80% U-POINT KHẢ DỤNG – LỊCH CHI TRẢ THEO QUÝ</p>
            </div>
            <div class="overflow-x-auto rounded-xl">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Kỳ</th>
                    <th>Quý</th>
                    <th>Thời gian ghi nhận</th>
                    <th>Ngày chi trả</th>
                    <th style="text-align:center">Tỷ lệ</th>
                  </tr>
                </thead>
