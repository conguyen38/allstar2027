<script is:inline>
    // Active sidebar link on scroll
    var sections = ['sec-1', 'sec-2', 'sec-3', 'sec-4'];
    var links = document.querySelectorAll('.sidebar-link');
    function onScroll() {
      var scrollY = window.scrollY + 120;
      var active = 0;
      sections.forEach(function (id, i) {
        var el = document.getElementById(id);
        if (el && el.offsetTop <= scrollY) active = i;
      });
      links.forEach(function (l, i) {
        l.classList.toggle('active', i === active);
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    // Smooth anchor scroll
    document.querySelectorAll('a[href^="#sec-"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        var target = document.querySelector(this.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });



    /* ────────────────── Active nav sync ────────────────── */
    function setActiveNav() {
      var filename = window.location.pathname.split('/').filter(Boolean).pop() || 'index.html';
      if (filename.indexOf('.') === -1 && filename !== 'index.html') filename += '.html';
      var map = {
        'index.html': 'index', 'index': 'index', '': 'index',
        'tong-quan-chuong-trinh.html': 'tong-quan', 'tong-quan-chuong-trinh': 'tong-quan',
        'the-le.html': 'the-le', 'the-le': 'the-le',
        'leaderboard-prm.html': 'bxh', 'leaderboard-prm': 'bxh',
        'refer-onetrust.html': 'refer', 'refer-onetrust': 'refer',
      };
      var active = map[filename] || 'index';
      document.querySelectorAll('[data-nav]').forEach(function (el) {
        if (el.dataset.nav === active) {
          el.classList.add('nav-active');
        } else {
          el.classList.remove('nav-active');
        }
      });
    }
    setActiveNav();
  </script>
  
