---
import ProgramLayout from '../../layouts/ProgramLayout.astro';

const title = "Tổng Quan Chương Trình Allstar Club | OneHousing";
const description = "Tìm hiểu chi tiết về chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing. Điều kiện tham gia, duy trì thành viên và các quy định về chuyển điểm trong hệ thống.";
---

<ProgramLayout
  title={title}
  description={description}
  canonicalPath="/prm/tong-quan-chuong-trinh/"
  program="prm"
  active="tong-quan"
  bodyClass="page-bg allstar-grid-bg text-on-surface font-body antialiased"
>
  <Fragment slot="head">
<script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Tổng Quan Chương Trình Allstar Club",
      "description": "Điều kiện tham gia và duy trì thành viên chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing",
      "publisher": {
        "@type": "Organization",
        "name": "OneHousing"
      }
    }
    </script>
<style>
        .glass-card {
            background: rgba(32, 38, 47, 0.4);
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(68, 72, 79, 0.3);
            border-left: 1px solid rgba(68, 72, 79, 0.3);
        }

        /* Dropdown */

        /* Hero background */
        .hero-banner {
            background-image: url('/assets/images/allstar-contest-headbanner.webp');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .hero-overlay {
            background: linear-gradient(to bottom, rgba(10, 14, 20, 0.8) 0%, rgba(10, 14, 20, 0.2) 50%, rgba(10, 14, 20, 0.8) 100%);
        }

        /* Perspective grid */
        .perspective-grid {
            background-image:
                linear-gradient(rgba(0, 227, 253, 0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 227, 253, 0.06) 1px, transparent 1px);
            background-size: 60px 60px;
            animation: grid-move 4s linear infinite;
            transform: perspective(600px) rotateX(55deg) scaleX(2.5);
            transform-origin: bottom center;
        }

        /* Speed lines */
        .speed-line {
            position: absolute;
            height: 1px;
            border-radius: 9999px;
            background: linear-gradient(90deg, transparent, rgba(0, 227, 253, 0.5), transparent);
            animation: speed-line 1.8s linear infinite;
        }

        /* Neon border cards */
        .card-neon-gold {
            border: 1px solid rgba(255, 209, 108, 0.35);
            box-shadow: 0 0 20px rgba(255, 209, 108, 0.08), inset 0 0 20px rgba(255, 209, 108, 0.03);
            background: rgba(255, 209, 108, 0.04);
            backdrop-filter: blur(16px);
        }

        .card-neon-gold:hover {
            border-color: rgba(255, 209, 108, 0.65);
            box-shadow: 0 0 40px rgba(255, 209, 108, 0.18), inset 0 0 30px rgba(255, 209, 108, 0.06);
            transform: translateY(-4px);
        }

        .card-neon-cyan {
            border: 1px solid rgba(0, 227, 253, 0.35);
            box-shadow: 0 0 20px rgba(0, 227, 253, 0.08), inset 0 0 20px rgba(0, 227, 253, 0.03);
            background: rgba(0, 227, 253, 0.04);
            backdrop-filter: blur(16px);
        }

        .card-neon-cyan:hover {
            border-color: rgba(0, 227, 253, 0.65);
            box-shadow: 0 0 40px rgba(0, 227, 253, 0.18), inset 0 0 30px rgba(0, 227, 253, 0.06);
            transform: translateY(-4px);
        }

        .card-neon-red {
            border: 1px solid rgba(255, 113, 104, 0.35);
            box-shadow: 0 0 20px rgba(255, 113, 104, 0.08), inset 0 0 20px rgba(255, 113, 104, 0.03);
            background: rgba(255, 113, 104, 0.04);
            backdrop-filter: blur(16px);
        }

        .card-neon-red:hover {
            border-color: rgba(255, 113, 104, 0.65);
            box-shadow: 0 0 40px rgba(255, 113, 104, 0.18), inset 0 0 30px rgba(255, 113, 104, 0.06);
            transform: translateY(-4px);
        }

        .card-neon-gold,
        .card-neon-cyan,
        .card-neon-red {
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Rule item */
        .rule-item {
            border-left: 2px solid transparent;
            transition: border-color 0.2s, padding-left 0.2s;
        }

        .rule-item:hover {
            padding-left: 0.5rem;
        }

        .rule-item-gold:hover {
            border-color: #ffd16c;
        }

        .rule-item-cyan:hover {
            border-color: #ffffff;
        }

        .rule-item-red:hover {
            border-color: #ff7168;
        }

        /* ── Page background & Neon trails ── */
        .page-bg {
            background:
                radial-gradient(ellipse 80% 50% at 20% 20%, rgba(0, 80, 180, 0.18) 0%, transparent 60%),
                radial-gradient(ellipse 60% 40% at 80% 10%, rgba(0, 227, 253, 0.1) 0%, transparent 50%),
                radial-gradient(ellipse 50% 60% at 50% 80%, rgba(80, 0, 180, 0.12) 0%, transparent 60%),
                #06091a;
            min-height: 100vh;
        }

        .trails-svg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.45;
        }

        @keyframes trail-move {
            0% {
                stroke-dashoffset: 1000;
                opacity: 0;
            }

            20% {
                opacity: 1;
            }

            80% {
                opacity: 0.6;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0;
            }
        }

        .trail-line {
            stroke-dasharray: 400 600;
            animation: trail-move 6s linear infinite;
        }

        .trail-line:nth-child(2) {
            animation-delay: 1.5s;
            animation-duration: 7s;
        }

        .trail-line:nth-child(3) {
            animation-delay: 3s;
            animation-duration: 5.5s;
        }

        .trail-line:nth-child(4) {
            animation-delay: 0.8s;
            animation-duration: 8s;
        }

        .trail-line:nth-child(5) {
            animation-delay: 2.2s;
            animation-duration: 6.5s;
        }
    </style>
  </Fragment>

  <Fragment slot="beforeHeader">
<!-- Neon light trails -->
    <svg class="trails-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <line class="trail-line" x1="-100" y1="200" x2="1540" y2="180" stroke="rgba(0,227,253,0.4)" stroke-width="1" />
        <line class="trail-line" x1="-100" y1="450" x2="1540" y2="420" stroke="rgba(255,209,108,0.35)"
            stroke-width="0.8" />
        <line class="trail-line" x1="-100" y1="680" x2="1540" y2="700" stroke="rgba(0,100,255,0.3)"
            stroke-width="1.2" />
        <line class="trail-line" x1="200" y1="-50" x2="180" y2="950" stroke="rgba(0,227,253,0.25)" stroke-width="0.8" />
        <line class="trail-line" x1="1100" y1="-50" x2="1120" y2="950" stroke="rgba(255,209,108,0.2)"
            stroke-width="1" />
    </svg>

    <!-- TopNavBar -->
  </Fragment>

<main class="pt-20">

        <!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->

        <!-- ═══════════════════════════════ RULES CARDS ═══════════════════════════════ -->
        <section id="rules" class="py-16 md:py-16 px-4 md:px-8 max-w-7xl mx-auto">

            <!-- Section header -->
            <div class="mb-10 md:mb-16">
                <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-3">Thể lệ tham gia và duy trì thành viên</h2>
            </div>

            <!-- Cards grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">

                <!-- Card 1: Điều kiện tham gia -->
                <div
                    class="glass-card p-8 rounded-3xl shadow-2xl border border-white/5 relative overflow-hidden group hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                    <div class="mb-4">
                        <span class="material-symbols-outlined text-4xl text-primary"
                            style="font-variation-settings:'FILL' 1,'wght' 400;">badge</span>
                    </div>
                    <div class="bg-[#1e293b]/50 text-white px-6 py-1 rounded-full text-sm font-bold uppercase mb-4">
                        Điều kiện tham gia
                    </div>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center py-2">
                            <span class="font-bold text-white/80 text-sm">LLTV cần đạt tối thiểu 05 điểm hợp lệ trong kỳ
                                tính điểm của chương trình để tham gia CLB Allstar.</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Duy trì thành viên -->
                <div
                    class="glass-card p-8 rounded-3xl shadow-2xl border border-white/5 relative overflow-hidden group hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                    <div class="mb-4">
                        <span class="material-symbols-outlined text-4xl text-primary"
                            style="font-variation-settings:'FILL' 1,'wght' 400;">trending_up</span>
                    </div>
                    <div class="bg-[#1e293b]/50 text-white px-6 py-1 rounded-full text-sm font-bold uppercase mb-4">
                        Duy trì thành viên
                    </div>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center py-2">
                            <span class="font-bold text-white/80 text-sm">Cần phát sinh tối thiểu 01 HBK trong H1 và H2
                                (H1 bao gồm Quý 1 và Quý 2, H2 bao gồm Quý 3 và Quý 4).</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Quy định chuyển điểm -->
                <div
                    class="glass-card p-8 rounded-3xl shadow-2xl border border-white/5 relative overflow-hidden group hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center sm:col-span-2 lg:col-span-1">
                    <div class="mb-4">
                        <span class="material-symbols-outlined text-4xl text-primary"
                            style="font-variation-settings:'FILL' 1,'wght' 400;">swap_horiz</span>
                    </div>
                    <div class="bg-[#1e293b]/50 text-white px-6 py-1 rounded-full text-sm font-bold uppercase mb-4">
                        Quy định chuyển điểm
                    </div>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="font-bold text-white/80 text-sm">Điểm sẽ được ghi nhận cho chi nhánh cũ tới
                                giao dịch cuối cùng trước khi chuyển sang chi nhánh mới. Sau giao dịch trên, điểm sẽ
                                được tính cho miền/ chi nhánh mới khi LLTV phát sinh giao dịch mới.</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="font-bold text-white/80 text-sm">Trong trường hợp LLTV có sự thay đổi về Vùng,
                                Chi nhánh hoặc cấp bậc (ví dụ: từ PRM lên PM, Headhub hoặc chuyển sang SRBO,...), quyền
                                lợi sẽ được áp dụng theo hạng tương ứng với cấp bậc tại thời điểm phát sinh.</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="font-bold text-white/80 text-sm">Nếu LLTV nghỉ việc, số điểm sẽ bị hủy ghi nhận
                                ở cả cá nhân &amp; tập thể.</span>
                        </div>
                    </div>
                </div>

            </div><!-- /grid -->

            <!-- Bottom notice -->
            <!-- <div
                class="mt-12 md:mt-16 rounded-2xl border border-white/10 bg-white/5 px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0">campaign</span>
                <p class="text-on-surface-variant text-sm leading-relaxed font-body">
                    <span class="text-white font-semibold">Lưu ý:</span> Ban tổ chức có quyền điều chỉnh quy định chương
                    trình với thông báo trước <span class="text-primary font-semibold">7 ngày làm việc</span>. Mọi thay
                    đổi sẽ được cập nhật trên hệ thống Allstar Apex và thông báo qua kênh chính thức.
                </p>
            </div> -->

        </section>

    </main>

    <!-- ═══════════════════════════════ FOOTER ═══════════════════════════════ -->

<style>
        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        /* ── Theme toggle button ── */
        .theme-toggle {
            transition: all 0.2s;
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

    </style>

    <script is:inline>


        /* ────────────────── Active nav sync ────────────────── */
        function setActiveNav() {
            var filename = window.location.pathname.split('/').filter(Boolean).pop() || 'index.html';
            if (filename.indexOf('.') === -1 && filename !== 'index.html') filename += '.html';
            var map = {
                'index.html': 'index', 'index': 'index', '': 'index',
                'tong-quan-chuong-trinh.html': 'tong-quan', 'tong-quan-chuong-trinh': 'tong-quan',
                'the-le.html': 'the-le', 'the-le': 'the-le',
                'leaderboard-prm.html': 'bxh', 'leaderboard-prm': 'bxh',
                'refer-onetrust.html': 'refer', 'refer-onetrust': 'refer',
            };
            var active = map[filename] || 'index';
            document.querySelectorAll('[data-nav]').forEach(function (el) {
                if (el.dataset.nav === active) {
                    el.classList.add('nav-active');
                } else {
                    el.classList.remove('nav-active');
                }
            });
        }
        setActiveNav();
    </script>
    
</ProgramLayout>

