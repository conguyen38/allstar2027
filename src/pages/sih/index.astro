---
import SunsetBanner from '../../components/SunsetBanner.astro';
import ProgramLayout from '../../layouts/ProgramLayout.astro';

const title = "LLB OneHousing - Chương trình loyalty Allstar Club";
const description = "Chương trình loyalty Allstar Club dành cho Lực lượng bán (LLB) OneHousing. Cơ chế tính điểm U-Point dựa trên GMV và thưởng bonus vượt mốc dành cho SA và SM.";
---

<ProgramLayout
  title={title}
  description={description}
  canonicalPath="/sih/"
  program="sih"
  active="index"
  bodyClass="page-bg text-on-surface font-body selection:bg-primary/30 selection:text-primary overflow-x-hidden"
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&display=swap" rel="stylesheet" />
<script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "LLB OneHousing - Allstar Club",
      "url": "https://allstar26.vercel.app/sih/",
      "description": "Chương trình loyalty dành cho lực lượng bán Techcombank và OneHousing - Phân hệ LLB OneHousing",
      "publisher": {
        "@type": "Organization",
        "name": "OneHousing"
      }
    }
    </script>
<style type="text/css">
        .glass-card {
            background: linear-gradient(145deg, rgba(85, 42, 85, 0.82), rgba(52, 30, 62, 0.74));
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(255, 141, 180, 0.34);
            border-left: 1px solid rgba(255, 141, 180, 0.24);
            box-shadow: inset 0 1px 0 rgba(255, 220, 205, 0.08), 0 18px 48px rgba(51, 30, 60, 0.26);
        }


        .hero-banner {
            background-image: url('/assets/images/allstar-sunset.webp');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .hero-overlay {
            background: linear-gradient(to bottom, rgba(17, 10, 20, 0.8) 0%, rgba(17, 10, 20, 0.2) 50%, rgba(17, 10, 20, 0.8) 100%);
        }

        /* ── Page background & Neon trails ── */
        .page-bg {
            background:
                radial-gradient(ellipse 72% 42% at 50% 10%, rgba(128, 63, 128, 0.38), transparent 72%),
                radial-gradient(ellipse 54% 34% at 100% 70%, rgba(255, 141, 180, 0.09), transparent 74%),
                linear-gradient(rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(135deg, #311c3a 0%, #24152b 48%, #2b1932 100%);
            background-size: auto, auto, 72px 72px, 72px 72px, auto;
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* Cùng bề mặt với nền nội dung: hero ghim tan vào nền mà không có mép cứng. */
        .hero-page-fade {
            background:
                radial-gradient(ellipse 72% 42% at 50% 10%, rgba(128, 63, 128, 0.38), transparent 72%),
                radial-gradient(ellipse 54% 34% at 100% 70%, rgba(255, 141, 180, 0.09), transparent 74%),
                linear-gradient(rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 141, 180, 0.045) 1px, transparent 1px),
                linear-gradient(135deg, #311c3a 0%, #24152b 48%, #2b1932 100%);
            background-size: auto, auto, 72px 72px, 72px 72px, auto;
            background-attachment: fixed;
        }

        .trails-svg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.72;
        }

        @keyframes trail-move {
            0% { stroke-dashoffset: 1000; opacity: 0; }
            20% { opacity: 1; }
            80% { opacity: 0.6; }
            100% { stroke-dashoffset: 0; opacity: 0; }
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .trail-line {
            stroke-dasharray: 400 600;
            animation: trail-move 6s linear infinite;
        }
        .trail-line:nth-child(2) { animation-delay: 1.5s; animation-duration: 7s; }
        .trail-line:nth-child(3) { animation-delay: 3s; animation-duration: 5.5s; }
        .trail-line:nth-child(4) { animation-delay: 0.8s; animation-duration: 8s; }
        .trail-line:nth-child(5) { animation-delay: 2.2s; animation-duration: 6.5s; }
    </style>
  </Fragment>

  <Fragment slot="beforeHeader">
<!-- Neon light trails -->
    <svg class="trails-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <line class="trail-line" x1="-100" y1="200" x2="1540" y2="180" stroke="rgba(255, 141, 180,0.4)" stroke-width="1" />
        <line class="trail-line" x1="-100" y1="450" x2="1540" y2="420" stroke="rgba(255, 196, 153,0.35)" stroke-width="0.8" />
        <line class="trail-line" x1="-100" y1="680" x2="1540" y2="700" stroke="rgba(255, 141, 180,0.3)" stroke-width="1.2" />
        <line class="trail-line" x1="200" y1="-50" x2="180" y2="950" stroke="rgba(255, 141, 180,0.25)" stroke-width="0.8" />
        <line class="trail-line" x1="1100" y1="-50" x2="1120" y2="950" stroke="rgba(255, 196, 153,0.2)" stroke-width="1" />
    </svg>
    <!-- TopNavBar -->
  </Fragment>

<main class="pt-20 program-info">
        <!-- Hero Banner -->
        <SunsetBanner program="sih" />
        <!-- Cách thức ghi điểm -->
        <section class="py-16 md:py-16 px-4 md:px-8 max-w-7xl mx-auto">
            <div class="mb-10 md:mb-16">
                <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-3" style="">Cơ chế tính
                    điểm & Phần thưởng</h2>
                <p class="text-white font-label font-normal text-sm" style="">Tùytính theo
                    vai trò, SIH sẽ nhận điểm thưởng và điểm bonus khi đạt các mốc tương ứng - 1 điểm = 1,000,000
                    U-Point</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
                <!-- Card 1: Tính điểm theo vai trò -->
                <div
                    class="score-card">
                    <h3 class="score-card__label">
                        Tính điểm theo vai trò
                    </h3>
                    <p class="text-white text-sm font-medium mb-2" style="">Tổng thưởng mỗi 1 tỷ GMV (không bao gồm
                        VAT & KPBT)
                    </p>
                    <div class="w-full space-y-3 mt-4">
                        <div class="flex justify-between items-center border-b border-white/5 py-2">
                            <span class="text-white/70 text-sm font-medium" style="">SM</span>
                            <span class="font-bold text-primary text-lg" style="">0.2 điểm</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-white/70 text-sm font-medium" style="">SA</span>
                            <span class="font-bold text-primary text-lg" style="">0.8 điểm</span>
                        </div>
                    </div>
                </div>
                <!-- Card 2: Quy đổi điểm thưởng -->
                <div
                    class="score-card">

                    <h3 class="score-card__label">
                        Thưởng bonus khi vượt mốc
                    </h3>
                    <p class="text-white text-sm font-medium mb-4" style="">Theo mốc GMV thực đạt dành cho SA</p>
                    <div class="w-full">
                        <table class="w-full text-sm border-collapse">
                            <thead>
                                <tr class="border-b border-white/10">
                                    <th class="py-2 px-3 text-center text-white font-bold text-sm uppercase">GMV (tỷ)
                                    </th>
                                    <th class="py-2 px-3 text-center text-white font-bold text-sm uppercase">Bonus (điểm)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-white text-lg">32</td>
                                    <td class="py-3 px-3 text-center font-bold text-primary text-lg">5</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-white text-lg">80</td>
                                    <td class="py-3 px-3 text-center font-bold text-primary text-lg">10</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-white text-lg">150</td>
                                    <td class="py-3 px-3 text-center font-bold text-primary text-lg">20</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-white text-lg">320</td>
                                    <td class="py-3 px-3 text-center font-bold text-primary text-lg">30</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-white text-lg">680</td>
                                    <td class="py-3 px-3 text-center font-bold text-primary text-lg">60</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Card 3: Cơ chế điểm thưởng -->
                <div
                    class="sm:col-span-2 score-card">

                    <h3 class="score-card__label">
                        Tổng điểm của SIH được quy đổi theo kết quả đánh giá hiệu
                        quả công việc mỗi kỳ.
                    </h3>
                    <div class="w-full overflow-x-auto mt-4" tabindex="0" role="region" aria-label="Bảng quy đổi điểm, kéo ngang để xem đầy đủ">
                        <table class="w-full text-sm border-collapse min-w-[500px]">
                            <thead>
                                <tr class="border-b border-white/10">
                                    <th class="py-2 px-3 text-center text-white font-bold text-sm uppercase">Xếp loại
                                    </th>
                                    <th class="py-2 px-3 text-center text-white font-bold text-sm uppercase">Đánh giá
                                    </th>
                                    <th class="py-2 px-3 text-center text-white font-bold text-sm uppercase">Quy đổi
                                        điểm</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-primary text-lg">A1</td>
                                    <td class="py-3 px-3 text-center font-normal text-white/85">Vượt trội</td>
                                    <td class="py-3 px-3 text-center font-bold text-white">Quy đổi <span
                                            class="text-primary text-lg">110%</span> tổng điểm</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-primary text-lg">A2</td>
                                    <td class="py-3 px-3 text-center font-normal text-white/85">Xuất sắc</td>
                                    <td class="py-3 px-3 text-center font-bold text-white">Quy đổi <span
                                            class="text-primary text-lg">105%</span> tổng điểm</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-primary text-lg">A3</td>
                                    <td class="py-3 px-3 text-center font-normal text-white/85">Đạt yêu cầu</td>
                                    <td class="py-3 px-3 text-center font-bold text-white">Quy đổi <span
                                            class="text-primary text-lg">100%</span> tổng điểm</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-primary text-lg">B</td>
                                    <td class="py-3 px-3 text-center font-normal text-white/85">Cần cải thiện</td>
                                    <td class="py-3 px-3 text-center font-bold text-white">Quy đổi <span
                                            class="text-primary text-lg">80%</span> tổng điểm</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-3 text-center font-black text-primary text-lg">C</td>
                                    <td class="py-3 px-3 text-center font-normal text-white/85">Không đạt yêu cầu</td>
                                    <td class="py-3 px-3 text-center font-bold text-white italic text-sm">Không áp dụng quy đổi</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
        <!-- QnA Accordion -->
        <section class="pt-16 pb-28 md:pb-40 px-4 md:px-8 max-w-4xl mx-auto">
            <h2 class="font-arena uppercase tracking-wide leading-[0.95] text-4xl md:text-6xl text-on-background mb-10 md:mb-16 text-center">Câu
                hỏi thường gặp</h2>
            <div id="faq-accordion" class="flex flex-col gap-3"></div>
        </section>
        <script is:inline>
            var faqData = [
                {
                    title: "Điểm được ghi nhận như thế nào?",
                    body: [
                        "Điểm <strong>tạm tính</strong> được ghi nhân tại thời điểm ráp căn thành công <strong>(HBK - OTP)</strong>.",
                        "Điểm sẽ bị <strong>thu hồi</strong> nếu giao dịch không chuyển đổi thành HĐMB."
                    ]
                },
                {
                    title: "Có thể rút quỹ thưởng bất kì lúc nào không? Thời gian chi trả là khi nào?",
                    body: [
                        "<strong>Không</strong>, việc chi trả thực tế sẽ dựa theo kỳ chi dự kiến nêu trong thể lệ, phụ thuộc vào thời gian hoàn tất <strong>HĐMB</strong>."
                    ]
                },
                {
                    title: "Xem điểm thưởng ở đâu?",
                    body: [
                        "Điểm thưởng sẽ được cập nhật <strong>real-time</strong> ở mục <strong>Bảng xếp hạng</strong> trên website chương trình, theo miền LLB."
                    ]
                },
                {
                    title: "LLB làm ở team A đến hết T3.2026 rồi chuyển sang team B, vậy 20% điểm cá nhân của LLB sẽ được tính theo team nào?",
                    body: [
                        "Điểm (bao gồm phần tạm khóa) sẽ ghi nhận cho <strong>team A</strong> tính đến giao dịch cuối cùng trước khi chuyển. Các giao dịch sau đó sẽ tính cho <strong>team B</strong>."
                    ]
                },
                {
                    title: "Nếu LLB bán cả dự án miền Bắc và miền Nam, điểm sẽ được tính như thế nào?",
                    body: [
                        "Điểm sẽ được tính theo <strong>miền của lực lượng tư vấn</strong>, điểm sẽ vẫn được cộng theo cơ chế chung, không theo miền dự án."
                    ]
                },
                {
                    title: "LLB có thể tra số dư điểm thưởng ở đâu?",
                    body: [
                        "LLB vui lòng liên hệ <strong>SM</strong> đang phụ trách hoặc liên hệ BTC qua hotline: <strong>Bùi Bích Phương - 0917701043</strong>"
                    ]
                },
                {
                    title: "LLB có thể gửi câu hỏi hoặc đóng góp ý kiến về chương trình qua kênh nào?",
                    body: [
                        "BTC tiếp nhận mọi câu hỏi và ý kiến đóng góp của LLB thông qua <strong>Google Form chính thức</strong> của chương trình: <a href=\"https://forms.gle/xsMVxV681t2ha9Hk7\" target=\"_blank\" class=\"text-primary hover:underline\">https://forms.gle/xsMVxV681t2ha9Hk7</a>",
                        "LLB vui lòng điền thông tin theo biểu mẫu để được hỗ trợ và phản hồi trong thời gian sớm nhất."
                    ]
                }
            ];

            function buildAccordion() {
                var container = document.getElementById("faq-accordion");
                if (!container) return;
                faqData.forEach(function (item, idx) {
                    var div = document.createElement("div");
                    div.className = "accordion-item";
                    div.innerHTML =
                        "<button class=\"accordion-trigger\" onclick=\"toggleAccordion(" + idx + ")\">" +
                        "<span>" + (idx + 1) + ". " + item.title + "</span>" +
                        "<span class=\"accordion-icon\">" +
                        "<svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">" +
                        "<line x1=\"7\" y1=\"1\" x2=\"7\" y2=\"13\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>" +
                        "<line x1=\"1\" y1=\"7\" x2=\"13\" y2=\"7\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>" +
                        "</svg>" +
                        "</span>" +
                        "</button>" +
                        "<div class=\"accordion-body\"><div class=\"accordion-content\" id=\"faq-content-" + idx + "\"></div></div>";
                    container.appendChild(div);
                    renderAccordionContent(idx);
                });
                var first = document.querySelector(".accordion-item");
                if (first) first.classList.add("is-open");
            }

            function renderAccordionContent(idx) {
                var data = faqData[idx];
                var el = document.getElementById("faq-content-" + idx);
                if (!el) return;
                var html = data.body.map(function (p) { return "<p>" + p + "</p>"; }).join("");
                if (data.formula) {
                    html += "<div class=\"mt-4 rounded-xl border border-white/10 bg-white/5 px-6 py-5 text-center\">"
                        + "<p class=\"text-white text-sm uppercase  mb-3\">C\u00f4ng th\u1ee9c c\u01a1 b\u1ea3n</p>"
                        + "<div class=\"inline-flex flex-col items-center gap-1\">"
                        + "<span class=\"text-white font-bold text-base\">Gi\u00e1 tr\u1ecb 1 \u0111i\u1ec3m</span>"
                        + "<span class=\"text-white/40 text-lg\">=</span>"
                        + "<div class=\"flex flex-col items-center\">"
                        + "<span class=\"border-b border-white/30 pb-1 mb-1 text-sm text-white/80 font-semibold px-2\">T\u1ed5ng gi\u00e1 tr\u1ecb qu\u1ef9 th\u01b0\u1edfng</span>"
                        + "<span class=\"text-sm text-white/80 font-semibold px-2\">T\u1ed5ng \u0111i\u1ec3m to\u00e0n l\u1ef1c l\u01b0\u1ee3ng</span>"
                        + "</div>"
                        + "<span class=\"text-white/40 text-lg\">&#215;</span>"
                        + "<span class=\"text-primary font-bold text-base\">H\u1ec7 s\u1ed1 LLTV <span class=\"text-white/60\">(0.5)</span></span>"
                        + "</div>"
                        + "</div>";
                }
                if (data.image) {
                    html += "<div class=\"mt-4 rounded-xl overflow-hidden border border-white/10\">"
                        + "<img src=\"" + data.image + "\" alt=\"\" class=\"w-full h-auto object-cover\" loading=\"lazy\">"
                        + "</div>";
                }
                el.innerHTML = html;
            }

            function toggleAccordion(idx) {
                document.querySelectorAll(".accordion-item").forEach(function (item, i) {
                    if (i === idx) { item.classList.toggle("is-open"); }
                    else { item.classList.remove("is-open"); }
                });
            }

            buildAccordion();
        </script>
    </main>
    <!-- Footer -->

<script is:inline>
        /* ────────────────── Active nav sync ────────────────── */
        function setActiveNav() {
            var filename = window.location.pathname.split('/').filter(Boolean).pop() || 'index.html';
            if (filename.indexOf('.') === -1 && filename !== 'index.html') filename += '.html';
            var map = {
                'index.html': 'index', 'index': 'index', '': 'index',
                'tong-quan-chuong-trinh.html': 'tong-quan', 'tong-quan-chuong-trinh': 'tong-quan',
                'the-le.html': 'the-le', 'the-le': 'the-le',
                'leaderboard-sih.html': 'bxh', 'leaderboard-sih': 'bxh',
            };
            var active = map[filename] || 'index';
            document.querySelectorAll('[data-nav]').forEach(function (el) {
                if (el.dataset.nav === active) {
                    el.classList.add('nav-active');
                } else {
                    el.classList.remove('nav-active');
                }
            });
        }
        setActiveNav();
    </script>
    
<script>import '../../scripts/hero-intro';
import '../../scripts/hero-fade';</script>
</ProgramLayout>
