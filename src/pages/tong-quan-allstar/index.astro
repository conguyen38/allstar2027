---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allstar Briefing </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background-color: #F8FAFC; color: #1E293B; overflow-x: hidden; }
        
        .glass-panel { 
            background: #FFFFFF; 
            border: 1px solid #E2E8F0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }
        
        .premium-container {
            background: linear-gradient(135deg, #EEF2F6 0%, #FFFFFF 100%);
            border: 1px solid #E2E8F0;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
        }

        .progress-container {
            display: flex;
            height: 12px;
            border-radius: 6px;
            overflow: hidden;
            width: 100%;
            background: #E2E8F0;
        }
        
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body class="antialiased min-h-screen py-10 px-4 md:px-8">

    <div class="max-w-6xl mx-auto space-y-10">
        
        <header class="text-center space-y-4 mb-8">
            <h1 class="font-display text-5xl md:text-6xl font-black text-slate-800 tracking-tight">
                ALLSTAR <span class="text-accent3">BRIEFING</span>
            </h1>
            <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">Tổng thể chương trình AllStar 2025 - 2026</p>
        </header>

        <!-- ĐIỂM CHUNG -->
        <section class="glass-panel rounded-2xl p-6">
            <h2 class="text-xs font-bold text-slate-400 mb-4 uppercase tracking-widest text-center">Đặc điểm chung chương trình</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl flex flex-col items-center text-center">
                    <div class="w-10 h-10 rounded-full bg-accent1/10 flex items-center justify-center text-accent1 mb-3"><i class="fa-solid fa-users"></i></div>
                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Đối tượng</div>
                    <div class="text-xs font-bold text-slate-800 mb-1">PNS Chiến lược (TCB)</div>
                    <div class="text-[10px] text-accent1 font-semibold bg-accent1/10 px-2 py-0.5 rounded">Cá nhân & Tập thể (Chi nhánh (CN))</div>
                </div>
                
                <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl flex flex-col items-center text-center">
                    <div class="w-10 h-10 rounded-full bg-accent3/10 flex items-center justify-center text-accent3 mb-3"><i class="fa-solid fa-network-wired"></i></div>
                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Kênh Nguồn</div>
                    <div class="text-xs font-bold text-slate-800">PARTNER_TCB</div>
                    <div class="text-[10px] font-semibold text-slate-500 mt-1">& Quỹ cấn chéo</div>
                </div>

                <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl flex flex-col items-center text-center">
                    <div class="w-10 h-10 rounded-full bg-accent4/10 flex items-center justify-center text-accent4 mb-3"><i class="fa-solid fa-right-to-bracket"></i></div>
                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Điều kiện tham gia</div>
                    <div class="text-xs font-bold text-slate-800">Tối thiểu 05 điểm</div>
                </div>

                <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl flex flex-col items-center text-center">
                    <div class="w-10 h-10 rounded-full bg-gold/10 flex items-center justify-center text-gold mb-3"><i class="fa-solid fa-wallet"></i></div>
                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Cơ chế & Trả thưởng</div>
                    <div class="text-xs font-bold text-slate-800 mb-1">U-Point (App OneU)</div>
                    <div class="text-[10px] font-semibold text-gold bg-gold/10 px-2 py-0.5 rounded">1 Điểm = 1 Triệu (ngoại trừ AllStar 2025) </div>
                </div>

                <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl flex flex-col items-center text-center">
                    <div class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center text-blue-600 mb-3"><i class="fa-solid fa-bullseye"></i></div>
                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Mốc tính thưởng</div>
                    <div class="text-sm font-black text-slate-800">Mốc cuối CE</div>
                </div>

                <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl flex flex-col items-center text-center">
                    <div class="w-10 h-10 rounded-full bg-accent2/10 flex items-center justify-center text-accent2 mb-3"><i class="fa-solid fa-gift"></i></div>
                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Quyền lợi khác</div>
                    <div class="text-[10px] font-semibold text-slate-700 leading-relaxed">
                        Thưởng tích lũy, Đào tạo, Sự kiện & Thông tin dự án
                    </div>
                </div>
            </div>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="glass-panel rounded-[2rem] p-8 border-t-4 border-t-accent1 relative overflow-hidden flex flex-col">
                <div class="absolute top-0 right-0 p-6 opacity-5 text-accent1"><i class="fa-solid fa-handshake text-8xl"></i></div>
                
                <div class="flex justify-between items-start mb-6 relative z-10">
                    <div>
                        <h2 class="font-display text-2xl font-bold text-slate-800 mb-2">Loyalty Allstar Club</h2>
                        <div class="flex gap-2">
                            <div class="badge bg-accent1/10 text-accent1 border border-accent1/20">
                                <i class="fa-regular fa-calendar mr-2"></i> 11/2025 - 01/2026
                            </div>
                            <div class="badge bg-slate-100 text-slate-600 border border-slate-200">
                                Trả theo Kỳ Đánh Giá
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6 relative z-10">
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-xs text-slate-500 font-semibold mb-1">Cơ chế tính điểm</div>
                        <div class="text-sm font-bold text-slate-800">Hành động giao dịch</div>
                        <div class="text-[10px] text-accent1 mt-1 font-medium">HBK • VBTT • HĐMB • Refer căn độc quyền</div>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-xs text-slate-500 font-semibold mb-1">Hệ số điểm dự án</div>
                        <div class="text-sm font-bold text-slate-800">Cố định</div>
                        <div class="text-[10px] text-accent1 mt-1 font-medium">Cao tầng 7đ | Thấp tầng theo chính sách dự án</div>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 col-span-2 flex items-center justify-between">
                        <div>
                            <div class="text-xs text-slate-500 font-semibold mb-1">Quy mô quỹ thưởng</div>
                            <div class="text-lg font-bold text-gold">Tối đa 15.1 Tỷ VNĐ</div>
                        </div>
                    </div>
                </div>

                <div class="mb-auto relative z-10 bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                    <div class="text-[10px] text-slate-500 font-bold mb-3 uppercase flex items-center gap-2"><i class="fa-solid fa-sitemap text-accent1"></i> Hệ số phân bổ Quỹ thưởng chung</div>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="bg-slate-50 border border-slate-100 rounded-lg py-2 px-1 text-center">
                            <div class="text-[9px] text-slate-500 font-bold uppercase mb-1">Cá nhân</div>
                            <div class="text-lg font-black text-accent1">0.5</div>
                        </div>
                        <div class="bg-slate-50 border border-slate-100 rounded-lg py-2 px-1 text-center">
                            <div class="text-[9px] text-slate-500 font-bold uppercase mb-1">C.Nhánh</div>
                            <div class="text-lg font-black text-accent4">0.3</div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100">
                    <div class="flex justify-between text-xs font-bold mb-2">
                        <span class="text-accent1">90% Kỳ Hiện Tại</span>
                        <span class="text-slate-500">10% Kỳ Tiếp Theo</span>
                    </div>
                    <div class="progress-container">
                        <div class="bg-accent1" style="width: 90%"></div>
                        <div class="bg-slate-300" style="width: 10%"></div>
                    </div>
                </div>
            </div>

            <div class="glass-panel rounded-[2rem] p-8 border-t-4 border-t-accent2 relative overflow-hidden flex flex-col">
                <div class="absolute top-0 right-0 p-6 opacity-5 text-accent2"><i class="fa-solid fa-rocket text-8xl"></i></div>
                
                <div class="flex justify-between items-start mb-6 relative z-10">
                    <div>
                        <h2 class="font-display text-2xl font-bold text-slate-800 mb-2">Special Bonus</h2>
                        <div class="flex gap-2">
                            <div class="badge bg-accent2/10 text-accent2 border border-accent2/20">
                                <i class="fa-regular fa-calendar mr-2"></i> Tháng 01/2026
                            </div>
                            <div class="badge bg-slate-100 text-slate-600 border border-slate-200">
                                Trả Tháng 2/2026
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6 relative z-10">
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 col-span-2">
                        <div class="text-xs text-slate-500 font-semibold mb-1">Mục tiêu cốt lõi</div>
                        <div class="text-sm font-bold text-slate-800">Thúc đẩy GMV & Ký kết đầu năm</div>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 col-span-2 flex items-center justify-between">
                        <div>
                            <div class="text-xs text-slate-500 font-semibold mb-1">Cơ sở tính thưởng</div>
                            <div class="text-sm font-bold text-slate-800">Theo giá trị GMV</div>
                        </div>
                        <div class="text-right text-[10px] font-medium text-slate-500 bg-white px-3 py-1.5 rounded-lg border border-slate-100">
                            Giá trị tính thưởng<br><strong class="text-accent2">Trước VAT & KPBT</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-auto relative z-10 space-y-3">
                    <!-- Cao Tầng -->
                    <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 shrink-0 rounded bg-accent2/10 flex items-center justify-center text-accent2 text-lg"><i class="fa-solid fa-building"></i></div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-1">
                                <div class="text-xs text-slate-800 font-bold">Dự án Cao Tầng</div>
                                <div class="text-xs font-black text-accent2">1.5đ <span class="text-[10px] text-slate-500 font-normal">/ 1 tỷ GMV</span></div>
                            </div>
                            <div class="flex flex-wrap gap-1 text-[10px] font-bold">
                                <span class="bg-accent4/10 text-accent4 px-1.5 py-0.5 rounded">CN: 0.5đ/tỷ</span>
                            </div>
                        </div>
                    </div>

                    <!-- Thấp Tầng -->
                    <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 shrink-0 rounded bg-accent1/10 flex items-center justify-center text-accent1 text-lg"><i class="fa-solid fa-house"></i></div>
                        <div class="flex-1">
                            <div class="text-xs text-slate-800 font-bold mb-1.5">Dự án Thấp tầng & Hàng hiệu</div>
                            <div class="grid grid-cols-1 gap-1.5 text-[9px]">
                                <div class="bg-slate-50 p-1.5 rounded border border-slate-100 flex justify-between">
                                    <span class="font-bold text-accent4">C.Nhánh:</span> 
                                    <span class="text-slate-600 text-right">Gộp chung bảng Cá nhân (Mốc 20-160 tỷ)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100">
                    <div class="flex justify-between text-xs font-bold mb-2">
                        <span class="text-accent2">90% Kỳ Hiện Tại</span>
                        <span class="text-slate-500">10% Kỳ Tiếp Theo</span>
                    </div>
                    <div class="progress-container">
                        <div class="bg-accent2" style="width: 90%"></div>
                        <div class="bg-slate-300" style="width: 10%"></div>
                    </div>
                </div>
            </div>
        </div>

        <section class="premium-container rounded-[2.5rem] p-6 md:p-10 mt-10">
            
            <div class="text-center mb-10">
                <div class="badge bg-accent3/10 text-accent3 border border-accent3/20 mb-4 px-4 py-1.5 text-sm">
                    <i class="fa-solid fa-crown mr-2"></i> Chương trình 2026: 02/2026 - 12/2026
                </div>
                <h2 class="font-display text-4xl md:text-5xl font-black text-slate-900">ALLSTAR 2026</h2>
                <p class="text-slate-500 mt-2 font-medium">Cơ sở tính GMV - Mở rộng nền tảng số & thị trường thứ cấp</p>
            </div>

            <!-- 1. GMV Sơ Cấp (Cá nhân & Tập thể) -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm mb-6 overflow-hidden p-6">
                
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-accent1/10 flex items-center justify-center text-accent1 text-2xl"><i class="fa-solid fa-building"></i></div>
                        <div>
                            <h3 class="font-bold text-xl text-slate-800">GMV Sơ Cấp</h3>
                            <p class="text-xs font-medium text-slate-500 mt-1">Cơ sở tính điểm trên mỗi <strong class="text-accent1">1 Tỷ VNĐ GMV</strong></p>
                        </div>
                    </div>
                </div>
                
                <div class="space-y-4">
                    <!-- Phân hệ Cá nhân -->
                    <div class="bg-slate-50/50 border border-slate-100 rounded-xl p-4 hover:shadow-sm transition-shadow">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-user text-accent1"></i>
                                <h4 class="font-bold text-slate-700 text-sm uppercase">Cá Nhân</h4>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex justify-between items-center bg-white border border-slate-200 p-4 rounded-xl shadow-sm hover:border-accent1/30 transition-colors">
                                <span class="font-semibold text-slate-700 text-sm">Sản phẩm Premium</span>
                                <span class="font-black text-accent1 text-2xl">1.0đ <span class="text-[10px] text-slate-400 font-normal">/ 1 tỷ</span></span>
                            </div>
                            <div class="flex justify-between items-center bg-white border border-slate-200 p-4 rounded-xl shadow-sm hover:border-accent1/30 transition-colors">
                                <span class="font-semibold text-slate-700 text-sm">Sản phẩm Branded</span>
                                <span class="font-black text-accent1 text-2xl">0.8đ <span class="text-[10px] text-slate-400 font-normal">/ 1 tỷ</span></span>
                            </div>
                        </div>
                    </div>

                    <!-- Phân hệ Tập thể -->
                    <div class="bg-slate-50/50 border border-slate-100 rounded-xl p-4 hover:shadow-sm transition-shadow">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-sitemap text-accent4"></i>
                                <h4 class="font-bold text-slate-700 text-sm uppercase">Tập Thể</h4>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 gap-3">
                            <div class="bg-white border border-slate-200 rounded-xl py-3 px-2 text-center shadow-sm hover:border-accent4/30 transition-colors">
                                <div class="text-[10px] text-slate-500 font-bold uppercase mb-1">Chi Nhánh</div>
                                <div class="text-2xl font-black text-accent4">0.5đ</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                <!-- OneHub -->
                <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-lg bg-accent4/10 flex items-center justify-center text-accent4 text-lg"><i class="fa-solid fa-globe"></i></div>
                            <div>
                                <h3 class="font-bold text-lg text-slate-800">Cơ chế OneHub</h3>
                                <span class="text-[10px] font-bold text-accent4 bg-accent4/10 px-2 py-0.5 rounded uppercase">Hoạt động Nền tảng số</span>
                            </div>
                        </div>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-sm font-semibold text-slate-700">Kích hoạt Tài khoản</span>
                                <span class="font-black text-accent4 text-lg">+0.1đ</span>
                            </div>
                            <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-sm font-semibold text-slate-700">Niêm yết <span class="text-[10px] text-slate-400 font-normal">(Đáp ứng 2K4D)</span></span>
                                <span class="font-black text-accent4 text-lg">+0.5đ <span class="text-[10px] text-slate-400 font-normal">/ niêm yết</span></span>
                            </div>
                            <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-sm font-semibold text-slate-700">Hoàn thành GD qua OneHub</span>
                                <span class="font-black text-accent4 text-lg">+0.5đ <span class="text-[10px] text-slate-400 font-normal">/ giao dịch</span></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- OneTrust -->
                <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-lg bg-accent2/10 flex items-center justify-center text-accent2 text-lg"><i class="fa-solid fa-handshake-angle"></i></div>
                            <div>
                                <h3 class="font-bold text-lg text-slate-800">Cơ chế OneTrust</h3>
                                <span class="text-[10px] font-bold text-accent2 bg-accent2/10 px-2 py-0.5 rounded uppercase">Thị trường Thứ cấp</span>
                            </div>
                        </div>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                                <span class="text-sm font-semibold text-slate-700">Quy đổi Cá nhân</span>
                                <span class="font-black text-accent2 text-xl">1.0đ <span class="text-[10px] text-slate-500 font-normal">/ 1 tỷ GMV NET</span></span>
                            </div>
                            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                                <span class="text-sm font-semibold text-slate-700">Thưởng Chi nhánh</span>
                                <span class="text-xs text-right text-slate-600 font-medium bg-slate-50 px-2 py-1.5 rounded border border-slate-100">CN <strong class="text-accent2">0.5</strong></span>
                            </div>
                            <div class="flex justify-between items-center pt-1 bg-slate-50 p-3 rounded-xl">
                                <span class="text-xs text-slate-500 font-bold"><i class="fa-solid fa-location-dot text-slate-400 mr-1"></i> Phạm vi dự án</span>
                                <span class="text-xs text-right font-bold text-slate-700">Cao tầng OCP1 & Cổ Loa</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-10 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                <h3 class="text-center font-bold text-slate-800 mb-6 uppercase tracking-widest text-sm flex items-center justify-center gap-3">
                    <span class="h-px w-10 bg-slate-200"></span>
                    Thưởng Bonus Milestone Lũy Tiến (Cá Nhân)
                    <span class="h-px w-10 bg-slate-200"></span>
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
                    
                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center hover:border-gold hover:shadow-md transition-all group">
                        <div class="text-[10px] text-slate-400 uppercase font-bold mb-1">Mốc đạt</div>
                        <div class="text-xl font-black text-slate-800 mb-2 group-hover:text-accent1 transition-colors">10đ</div>
                        <div class="bg-accent1/10 text-accent1 text-xs py-1.5 rounded-lg mb-2 font-bold border border-accent1/20">+5đ</div>
                        <div class="text-[10px] text-slate-500 font-medium">Lũy kế: <span class="text-slate-800 font-bold">5</span></div>
                    </div>

